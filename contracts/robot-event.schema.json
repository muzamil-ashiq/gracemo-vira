{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vira.robotics/schemas/robot-event.schema.json",
  "title": "VIRA Robot Feedback Event Schema",
  "description": "Standardized events emitted by Robot Bridge, ROS 2, and physical sensors back to the Kernel and Interaction layer.",
  "oneOf": [
    { "$ref": "#/$defs/RobotPosition" },
    { "$ref": "#/$defs/RobotBattery" },
    { "$ref": "#/$defs/NavigationStarted" },
    { "$ref": "#/$defs/NavigationProgress" },
    { "$ref": "#/$defs/NavigationArrived" },
    { "$ref": "#/$defs/NavigationFailed" },
    { "$ref": "#/$defs/ObstacleDetected" },
    { "$ref": "#/$defs/PersonVisible" },
    { "$ref": "#/$defs/RobotStopped" },
    { "$ref": "#/$defs/RobotFault" },
    { "$ref": "#/$defs/RobotRecovered" }
  ],
  "$defs": {
    "RobotPosition": {
      "type": "object",
      "required": ["x", "y", "theta", "speed"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "theta": { "type": "number" },
        "speed": { "type": "number" },
        "current_room": { "type": "string" }
      },
      "additionalProperties": false
    },
    "RobotBattery": {
      "type": "object",
      "required": ["level", "charging"],
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 100 },
        "voltage": { "type": "number" },
        "charging": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "NavigationStarted": {
      "type": "object",
      "required": ["destination", "target_x", "target_y"],
      "properties": {
        "destination": { "type": "string" },
        "target_x": { "type": "number" },
        "target_y": { "type": "number" },
        "estimated_duration_sec": { "type": "number" }
      },
      "additionalProperties": false
    },
    "NavigationProgress": {
      "type": "object",
      "required": ["destination", "current_x", "current_y", "distance_remaining_m", "fraction_completed"],
      "properties": {
        "destination": { "type": "string" },
        "current_x": { "type": "number" },
        "current_y": { "type": "number" },
        "distance_remaining_m": { "type": "number", "minimum": 0.0 },
        "fraction_completed": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "current_waypoint_idx": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "NavigationArrived": {
      "type": "object",
      "required": ["destination", "success"],
      "properties": {
        "destination": { "type": "string" },
        "success": { "type": "boolean" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "NavigationFailed": {
      "type": "object",
      "required": ["destination", "reason"],
      "properties": {
        "destination": { "type": "string" },
        "reason": { "type": "string" },
        "stuck_at_x": { "type": "number" },
        "stuck_at_y": { "type": "number" },
        "recovery_attempts": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "ObstacleDetected": {
      "type": "object",
      "required": ["distance", "direction"],
      "properties": {
        "distance": { "type": "number", "minimum": 0.0 },
        "direction": { "type": "string", "enum": ["front", "front_left", "front_right", "left", "right", "rear"] },
        "bearing_rad": { "type": "number" },
        "emergency_brake_triggered": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "PersonVisible": {
      "type": "object",
      "required": ["identity", "confidence"],
      "properties": {
        "identity": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "distance": { "type": ["number", "null"] },
        "bearing_rad": { "type": ["number", "null"] },
        "track_id": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "RobotStopped": {
      "type": "object",
      "required": ["reason", "x", "y"],
      "properties": {
        "reason": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "emergency": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "RobotFault": {
      "type": "object",
      "required": ["subsystem", "error_code", "message"],
      "properties": {
        "subsystem": { "type": "string" },
        "error_code": { "type": "string" },
        "message": { "type": "string" },
        "fatal": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "RobotRecovered": {
      "type": "object",
      "required": ["subsystem", "status"],
      "properties": {
        "subsystem": { "type": "string" },
        "status": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
