{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vira.robotics/schemas/interaction.schema.json",
  "title": "VIRA Interaction Event Schema",
  "description": "Payload definitions for human-robot dialogue, intent parsing, cognitive states, and emotion expressions.",
  "oneOf": [
    {
      "$ref": "#/$defs/VoiceDetected"
    },
    {
      "$ref": "#/$defs/VoiceIntent"
    },
    {
      "$ref": "#/$defs/InteractionStateChanged"
    },
    {
      "$ref": "#/$defs/ExpressionSet"
    },
    {
      "$ref": "#/$defs/GestureExecute"
    }
  ],
  "$defs": {
    "VoiceDetected": {
      "type": "object",
      "required": ["transcription"],
      "properties": {
        "transcription": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "language": {
          "type": "string",
          "default": "en"
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0.0
        },
        "is_final": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "VoiceIntent": {
      "type": "object",
      "required": ["intent", "confidence"],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "NAVIGATE",
            "STOP",
            "GREET",
            "HAND_HI",
            "HAND_UP",
            "HAND_DOWN",
            "LOOK_AT",
            "STATUS_REPORT",
            "IDENTITY",
            "QUERY",
            "COMMAND",
            "GENERAL_QUERY"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "target": {
          "type": ["string", "null"]
        },
        "entities": {
          "type": "object",
          "additionalProperties": true
        },
        "raw_transcript": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InteractionStateChanged": {
      "type": "object",
      "required": ["previous_state", "current_state"],
      "properties": {
        "previous_state": {
          "type": "string",
          "enum": [
            "BOOT",
            "IDLE",
            "LISTENING",
            "THINKING",
            "SPEAKING",
            "EXECUTING",
            "WAITING",
            "ERROR",
            "RECOVERY",
            "EMERGENCY_STOP",
            "SHUTDOWN"
          ]
        },
        "current_state": {
          "type": "string",
          "enum": [
            "BOOT",
            "IDLE",
            "LISTENING",
            "THINKING",
            "SPEAKING",
            "EXECUTING",
            "WAITING",
            "ERROR",
            "RECOVERY",
            "EMERGENCY_STOP",
            "SHUTDOWN"
          ]
        },
        "active_task": {
          "type": "string"
        },
        "active_expression": {
          "type": "string",
          "enum": ["idle", "happy", "focus", "sad", "angry", "intent"]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ExpressionSet": {
      "type": "object",
      "required": ["emotion"],
      "properties": {
        "emotion": {
          "type": "string",
          "enum": ["idle", "happy", "focus", "sad", "angry", "intent"]
        },
        "transition_video": {
          "type": "string",
          "description": "Relative transition folder path such as focus-happy or idle-idle."
        },
        "caption": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5
        }
      },
      "additionalProperties": false
    },
    "GestureExecute": {
      "type": "object",
      "required": ["gesture"],
      "properties": {
        "gesture": {
          "type": "string",
          "enum": ["hand_hi", "hand_up", "hand_down", "look_home", "head_nod", "head_shake"]
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10.0
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
