{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vira.robotics/schemas/robot-command.schema.json",
  "title": "VIRA Robot Command Contract",
  "description": "Semantic action commands emitted by Cognitive Brain or Safety Gateway. Strictly forbids direct motor, PWM, or raw velocity controls.",
  "type": "object",
  "required": ["action", "params"],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "Speak",
        "NavigateTo",
        "TurnTo",
        "NavigateToRoom",
        "LookAt",
        "ScanRoom",
        "Express",
        "Stop",
        "Pause",
        "Resume"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "Speak" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "emotion": {
                "type": "string",
                "enum": ["idle", "happy", "focus", "sad", "angry", "intent"],
                "default": "happy"
              },
              "gesture": {
                "type": "string",
                "enum": ["hand_hi", "hand_up", "hand_down", "none"],
                "default": "none"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "NavigateTo" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "yaw": { "type": ["number", "null"] },
              "target_name": { "type": "string" },
              "tolerance_m": { "type": "number", "minimum": 0.05, "maximum": 2.0, "default": 0.3 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "NavigateToRoom" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["room"],
            "properties": {
              "room": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "TurnTo" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["yaw"],
            "properties": {
              "yaw": { "type": "number", "minimum": -3.14159265359, "maximum": 3.14159265359 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "LookAt" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number", "default": 0.645 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "ScanRoom" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "pan_range_deg": { "type": "number", "minimum": 10.0, "maximum": 120.0, "default": 60.0 },
              "tilt_deg": { "type": "number", "minimum": -45.0, "maximum": 45.0, "default": 10.0 },
              "speed_deg_s": { "type": "number", "minimum": 5.0, "maximum": 90.0, "default": 25.0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "Express" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["emotion"],
            "properties": {
              "emotion": {
                "type": "string",
                "enum": ["idle", "happy", "focus", "sad", "angry", "intent"]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "Stop" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "reason": { "type": "string" },
              "emergency": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
