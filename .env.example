# GraceEMO Interaction — Environment Variables
# Copy to .env and fill in your API keys.

# ── LLM Backends (priority: Gemini → Groq → Ollama → heuristics) ──

# Google Gemini (primary — fastest, most capable)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud LPU (fast fallback)
GROQ_API_KEY=your_groq_api_key_here

# Ollama local inference (no internet needed)
# Default: http://localhost:11434/v1
OLLAMA_API_BASE=http://localhost:11434/v1

# ── Logging ────────────────────────────────────────────────────────
# Set to DEBUG for verbose output, WARNING for quiet
LOG_LEVEL=WARNING
