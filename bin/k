        str(ROOT / "scripts" / "test_wall_reflex.py")
    ]
    subprocess.run(cmd)


def cmd_pipe(args):
    """Execute a stream of piped .k commands via native Rust K Engine."""
    pipe_str = " ".join(args.pipeline)
    ensure_kernel_running()
    from gracemo_sdk.k_client import KClient
    client = KClient(KERNEL_URL)
    print(f"⚡ [K ENGINE] Executing pipeline: {pipe_str}")
    res = client.execute(pipe_str)
    if res.get("success"):
        summary = res.get("result", {})
        print(f"✓ Pipeline succeeded! Completed {summary.get('completed_stages')}/{summary.get('total_stages')} stages.")
        for st in summary.get("stage_results", []):
            print(f"  • {st.get('noun')}::{st.get('verb')} -> {st.get('output')} ({st.get('execution_time_ms')}ms)")
    else:
        print(f"⚠️ K Engine dispatch error: {res.get('error')}")
        from gracemo_sdk.workflow_engine import WorkflowEngine
        engine = WorkflowEngine()
        engine.execute_pipe(pipe_str)


def cmd_run(args):
    """Execute a .k workflow script file."""
    filepath = args.file
    try:
        with open(filepath, "r") as f:
            content = f.read().strip()
        cmd_pipe(argparse.Namespace(pipeline=[content]))
    except Exception as e:
        print(f"Error reading workflow file: {e}")


def cmd_memory_query(args):
    """Query episodic memory ledger."""
    query = " ".join(args.query).lower().strip()
    print(f"🔍 Querying Kernel Episodic Memory for: \"{query}\"...")
    try:
        resp = requests.get(f"{KERNEL_URL}/history?limit=50", timeout=2.0)
        if resp.status_code != 200:
            print("⚠️ Kernel is offline or unreachable.")
            return

        events = resp.json()
        matches = []
        for ev in events:
            ev_str = json.dumps(ev).lower()
            if query in ev_str:
                matches.append(ev)

        if not matches:
            print(f"No ledger records matching '{query}' found.")
            return

        print(f"✓ Found {len(matches)} matching event(s) in Ledger:")
        for m in matches[:10]:
            ts_str = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(m.get("timestamp", time.time())))
            print(f"  • [{ts_str}] {m.get('event_type')}: {m.get('payload')}")
    except Exception as e:
        print(f"Error querying ledger: {e}")


def cmd_context(args):
    """Fetch and display compiled truth context from ViRa Chrono-Spatial Compiler (VCSC)."""
    fmt = getattr(args, "format", None)
    if getattr(args, "json", False):
        fmt = "json"
    fmt = fmt or "toon"

    try:
        resp = requests.get(f"{KERNEL_URL}/context?format={fmt}", timeout=2.0)
        if resp.status_code == 200:
            if fmt == "json":
                print(json.dumps(resp.json(), indent=2))
            else:
                print(f"🧠 [VCSC COMPILED CONTEXT ({fmt.upper()})]:\n")
                print(resp.text)
        else:
            print(f"Kernel returned status {resp.status_code}")
    except Exception as e:
        print(f"Error: {e}")


def cmd_memory_remember(args):
    """Remember a fact in the kernel ledger."""
    fact = " ".join(args.fact)
    source = getattr(args, "source", "gemini-cli")
    try:
        from gracemo_sdk import AdapterClient
        client = AdapterClient(adapter_name="k-cli", base_url=KERNEL_URL)
        ok = client.emit("Custom", {"name": "FactRemembered", "payload": {"fact": fact, "source": source}}, source="System")
        if ok:
            print(f"✓ Remembered in Kernel Ledger: \"{fact}\" (source: {source})")
        else:
            print(f"⚠️ Failed to record in Kernel Ledger (is Kernel running at {KERNEL_URL}?)")
    except Exception as e:
        print(f"Error: {e}")


def cmd_graph(args):
    """Display the live Relational Knowledge Graph from SQLite GraphDb."""
    target_obj = getattr(args, "object", None)
    if target_obj:
        print(f"🕸️ Querying Knowledge Graph for: \"{target_obj}\"...")
        try:
            resp = requests.get(f"{KERNEL_URL}/graph?object={target_obj}", timeout=2.0)
            if resp.status_code == 200:
                data = resp.json()
                if data.get("found"):
                    res = data["result"]
                    ts_str = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(res.get("timestamp", time.time())))
                    print(f"✓ Found in Knowledge Graph:")
                    print(f"  • Entity:       {res.get('object')}")
                    print(f"  • Relation:     {res.get('relation')} -> {res.get('location')}")
                    print(f"  • Confidence:   {res.get('confidence', 1.0) * 100:.1f}%")
                    print(f"  • Last Seen:    {ts_str}")
                else:
                    print(f"ℹ️ {data.get('message')}")
            else:
                print(f"Error querying graph: HTTP {resp.status_code}")
        except Exception as e:
            print(f"Error: {e}")
        return

    print("🕸️ ── GRaCEmo ViRa Live Knowledge Graph (SQLite GraphDb) ──")
    try:
        resp = requests.get(f"{KERNEL_URL}/graph", timeout=2.0)
        if resp.status_code != 200:
            print("⚠️ Kernel is offline or unreachable.")
            return

        data = resp.json()
        nodes = data.get("nodes", [])
        edges = data.get("edges", [])

        print(f"  Total Entities: {len(nodes)} nodes | Relational Connections: {len(edges)} edges\n")

        rooms = [n for n in nodes if n.get("type") == "Room"]
        objects = [n for n in nodes if n.get("type") == "Object"]

        print("  [Apartment Floorplan Topology]")
        for room in rooms:
            room_edges = [e for e in edges if e.get("target") == room.get("id")]
            print(f"    ├── 📍 {room.get('label')}")
            if room_edges:
                for edge in room_edges:
                    src = edge.get("source", "").replace("object:", "")
                    print(f"    │     └── 👁️ [{edge.get('relation')}] {src} (conf: {edge.get('confidence', 1.0)*100:.0f}%)")
            else:
                print(f"    │     └── (No objects detected here yet)")

        if not edges:
            print("\n  💡 Tip: When ViRa navigates and inspects rooms in Gazebo, live camera YOLOv11 detections populate this graph dynamically!")

    except Exception as e:
        print(f"Error querying graph: {e}")


def main():
    parser = argparse.ArgumentParser(description="GRaCEmo ViRa 'k' Command CLI")
    subparsers = parser.add_subparsers(dest="command")

    # k forward / k backward / k spin / k stop
    p_fwd = subparsers.add_parser("forward", help="Drive straight forward")
    p_fwd.add_argument("seconds", nargs="?", default=3.0, type=float, help="Seconds to drive (default 3.0)")
    p_fwd.add_argument("--speed", default=0.7, type=float, help="Speed m/s (default 0.7)")

    p_bwd = subparsers.add_parser("backward", help="Drive straight backward")
    p_bwd.add_argument("seconds", nargs="?", default=3.0, type=float, help="Seconds to drive (default 3.0)")
    p_bwd.add_argument("--speed", default=-0.7, type=float, help="Speed m/s (default -0.7)")

    p_spin = subparsers.add_parser("spin", help="Spin in place")
    p_spin.add_argument("seconds", nargs="?", default=2.0, type=float, help="Seconds to spin (default 2.0)")
    p_spin.add_argument("--speed", default=1.2, type=float, help="Spin speed rad/s (default 1.2)")

    subparsers.add_parser("stop", help="Emergency stop")

    # k arm <reach/grab/release/wave/reset>
    p_arm = subparsers.add_parser("arm", help="Humanoid arm & gripper manipulation")
    arm_sub = p_arm.add_subparsers(dest="arm_action")
    p_reach = arm_sub.add_parser("reach", help="Reach arm forward")
    p_reach.add_argument("side", nargs="?", default="right", choices=["left", "right"], help="Arm to reach (default right)")
    arm_sub.add_parser("grab", help="Close gripper fingers")
    arm_sub.add_parser("release", help="Open gripper fingers")
    arm_sub.add_parser("reset", help="Reset arms to neutral stance")
    arm_sub.add_parser("wave", help="Wave humanoid hand")

    # k status
    p_status = subparsers.add_parser("status", help="Get clean robot telemetry status")
    p_status.add_argument("--json", action="store_true", help="Output as raw JSON")

    # k reload
    subparsers.add_parser("reload", help="Hot reload robot model & configs in Gazebo without restart")

    # k goto <room>
    p_goto = subparsers.add_parser("goto", help="Navigate autonomously to a room through doorway waypoints")
    p_goto.add_argument("room", help="Target room (kitchen, bedroom, living, study, hallway)")

    # k speak <text>
    p_speak = subparsers.add_parser("speak", help="Speak text through TTS")
    p_speak.add_argument("text", nargs="+", help="Text to speak")

    # k scan
    subparsers.add_parser("scan", help="Scan current room with YOLOv11 vision")

    # k hud / k view
    subparsers.add_parser("hud", help="Open live 30 FPS camera video HUD with real-time YOLO bounding boxes")
    subparsers.add_parser("view", help="Open live 30 FPS camera video HUD with real-time YOLO bounding boxes")

    # k graph
    p_graph = subparsers.add_parser("graph", help="Show Spatial Knowledge Graph")
    p_graph.add_argument("--object", "-o", help="Query specific object location in knowledge graph")

    # k verify / k test
    subparsers.add_parser("verify", help="Run 1-click full system, perception & brain verification")
    subparsers.add_parser("test", help="Run 1-click full system, perception & brain verification")

    # k reset / k center
    subparsers.add_parser("reset", help="Reset ViRa to dead center (0.0, 0.0) of Central Hallway")
    subparsers.add_parser("center", help="Reset ViRa to dead center (0.0, 0.0) of Central Hallway")

    # k reflex
    subparsers.add_parser("reflex", help="Test Autonomous LiDAR Reflex Shield (Spinal Cord Obstacle Avoidance)")

    # k explore / k patrol
    subparsers.add_parser("explore", help="Autonomous First Walk discovery patrol to map unknown apartment")
    subparsers.add_parser("patrol", help="Autonomous First Walk discovery patrol to map unknown apartment")

    # k pipe (Execute stream of .k pipes)
    p_pipe = subparsers.add_parser("pipe", help="Execute stream of piped .k commands")
    p_pipe.add_argument("pipeline", nargs="+", help="Pipeline string (e.g. 'nav::goto[bedroom] | vision::scan')")

    # k run (Execute .k workflow file)
    p_run = subparsers.add_parser("run", help="Execute .k workflow script file")
    p_run.add_argument("file", help="Path to .k script file")

    # k memory
    p_mem = subparsers.add_parser("memory", help="Memory operations")
    mem_sub = p_mem.add_subparsers(dest="mem_cmd")

    p_mem_q = mem_sub.add_parser("query", help="Query episodic memory")
    p_mem_q.add_argument("query", nargs="+", help="Search query")

    p_mem_r = mem_sub.add_parser("remember", help="Store memory fact")
    p_mem_r.add_argument("--source", default="gemini-cli", help="Source attribution")
    p_mem_r.add_argument("fact", nargs="+", help="Fact to store")

    p_mem_u = mem_sub.add_parser("update", help="Update memory fact")
    p_mem_u.add_argument("--source", default="gemini-cli", help="Source attribution")
    p_mem_u.add_argument("fact", nargs="+", help="Fact to update")

    # k context
    p_ctx = subparsers.add_parser("context", help="Fetch compiled context from ViRa Chrono-Spatial Compiler (VCSC)")
    p_ctx.add_argument("--format", "-f", default="toon", choices=["toon", "kpipe", "json"], help="Output format: toon (default), kpipe, json")
    p_ctx.add_argument("--json", action="store_true", help="Output raw JSON")

    args = parser.parse_args()

    if args.command == "forward":
        cmd_forward(args)
    elif args.command == "backward":
        cmd_backward(args)
    elif args.command == "spin":
        cmd_spin(args)
    elif args.command == "stop":
        cmd_stop(args)
    elif args.command == "arm":
        cmd_arm(args)
    elif args.command == "status":
        cmd_status(args)
    elif args.command == "context":
        cmd_context(args)
    elif args.command == "reload":
        cmd_reload(args)
    elif args.command == "goto":
        cmd_goto(args)
    elif args.command == "speak":
        cmd_speak(args)
    elif args.command == "scan":
        cmd_scan(args)
    elif args.command in ("hud", "view"):
        cmd_hud(args)
    elif args.command == "graph":
        cmd_graph(args)
    elif args.command in ("verify", "test"):
        import importlib.util
        spec = importlib.util.spec_from_file_location("verify_all", str(ROOT / "scripts" / "verify_all.py"))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        mod.main()
    elif args.command in ("reset", "center"):
        cmd_reset(args)
    elif args.command == "reflex":
        cmd_reflex(args)
    elif args.command in ("explore", "patrol"):
        cmd_explore(args)
    elif args.command == "pipe":
        cmd_pipe(args)
    elif args.command == "run":
        cmd_run(args)
    elif args.command == "memory":
        if args.mem_cmd == "query":
            cmd_memory_query(args)
        elif args.mem_cmd == "remember" or args.mem_cmd == "update":
            cmd_memory_remember(args)
        else:
            p_mem.print_help()
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
