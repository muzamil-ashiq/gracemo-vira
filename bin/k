def cmd_speak(args):
    """Speak text through neural TTS."""
    text = " ".join(args.text)
    print(f"🗣️ ViRa speaking: \"{text}\"")
    try:
        requests.post(f"{KERNEL_URL}/emit", json={"event_type": "ActionRequested", "payload": {"action": "Speak", "params": {"text": text}}, "source": "k-cli"}, timeout=1.0)
    except Exception as e:
        print(f"Error: {e}")


def cmd_scan(args):
    """Run real-time vision scan on the current room using live Knowledge Graph."""
    print("👁️ Scanning environment with YOLOv11...")
    ensure_kernel_running()
    try:
        resp = requests.get(f"{KERNEL_URL}/context", timeout=1.5)
        if resp.status_code == 200:
            ctx = resp.json()
            now = ctx.get("now", {})
            room = now.get("current_room", "Central Hallway")
            graph = ctx.get("graph", {})
            edges = graph.get("edges", [])

            located_edges = [e for e in edges if e.get("relation") == "LOCATED_IN"]

            print(f"📍 Robot Stationed: {room}")
            if located_edges:
                print(f"✓ Visually Verified Entities in Knowledge Graph ({len(located_edges)}):")
                for e in located_edges:
                    src = e.get("source", "").replace("object:", "")
                    target = e.get("target", "").replace("room:", "").replace("_", " ").title()
                    conf = e.get("confidence", 1.0) * 100
                    print(f"  • {src.upper():<16} ──[LOCATED_IN]──> {target} (conf: {conf:.1f}%)")
            else:
                print(f"  (No objects visually sighted in {room} yet)")
        else:
            print(f"Kernel returned status {resp.status_code}")
    except Exception as e:
        print(f"Error: {e}")


