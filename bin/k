def cmd_reset(args):
    """Instantly reset ViRa back to dead center (0.0, 0.0) of Central Hallway."""
    print("🔄 Resetting ViRa to dead center of Central Hallway (0.0, 0.0)...")
    cmd = [
        os.path.expanduser("~/.local/bin/distrobox"),
        "enter",
        "gracemo-harmonic",
        "--",
        "bash",
        "-c",
        "gz service -s /world/gracemo_home/control --reqtype gz.msgs.WorldControl --reptype gz.msgs.Boolean --timeout 2000 --req 'reset: {all: true}'"
    ]
    res = subprocess.run(cmd, capture_output=True, text=True)
    if "data: true" in res.stdout:
        print("✓ ViRa reset to Central Hallway (0.0, 0.0) with zero heading error!")
    else:
        print(f"Result: {res.stdout.strip() or res.stderr.strip()}")


