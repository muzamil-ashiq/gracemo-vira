  "risks": [
    {
      "id": "RISK-01",
      "severity": "CRITICAL",
      "description": "MLX Framework Incompatibility on Jetson: The local Qwen 2.5 3B model currently uses Apple-proprietary MLX framework which cannot execute on NVIDIA Jetson or Raspberry Pi.",
      "mitigation": "Export safetensors to TensorRT-LLM or deploy via Ollama/llama.cpp before hardware deployment."
    },
    {
      "id": "RISK-02",
      "severity": "HIGH",
      "description": "NVIDIA Riva Memory & Platform Overhead: Riva containers require 3.5GB to 5.0GB unified memory and specific JetPack versions, creating severe contention on 16GB Orin NX if run concurrently with local LLM.",
      "mitigation": "Keep lightweight modular voice pipeline (Silero + Faster-Whisper + Kokoro) as baseline, or mandate AGX Orin 64GB if Riva is strictly required."
    },
    {
      "id": "RISK-03",
      "severity": "HIGH",
      "description": "Missing Person ReID Implementation: Person ReID is currently a stub assigning identity to default_user without visual feature embeddings.",
      "mitigation": "Integrate OSNet or FastReID ONNX model on Jetson before claiming follow-me / ReID capability."
    },
    {
      "id": "RISK-04",
      "severity": "MEDIUM",
      "description": "Distributed Ethernet TF Sync Jitter: Splitting Nav2 across Pi 5 and Vision across Jetson introduces network serialization delay on camera/pointcloud streams.",
      "mitigation": "Use Gigabit Ethernet with PTP (IEEE 1588) clock synchronization or consolidate Nav2 directly onto Jetson Orin NX."
    }
  ],
