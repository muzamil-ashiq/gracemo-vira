# =============================================================================
# GraceEMO ViRa — Production ROS 2 Jazzy Docker Image (LPU Digital Twin)
# =============================================================================
# Base: Ubuntu 24.04 + ROS 2 Jazzy Desktop (includes RViz2, rqt, demo nodes)
# Adds: Nav2, SLAM, Gazebo Harmonic bridge, teleop, AI/ML Python packages,
#       Central AI Server, Dashboard dependencies, Research framework
# =============================================================================
FROM osrf/ros:jazzy-desktop

# Avoid interactive prompts during apt installs
ENV DEBIAN_FRONTEND=noninteractive

# ---------- ROS 2 Robotics Packages ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Navigation2 (path planning, obstacle avoidance, costmaps)
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    # SLAM Toolbox (2D LiDAR mapping)
    ros-jazzy-slam-toolbox \
    # Gazebo Harmonic ↔ ROS 2 bridge
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-ros-gz-bridge \
    # Teleop (keyboard control)
    ros-jazzy-teleop-twist-keyboard \
    # Robot model tools
    ros-jazzy-xacro \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher-gui \
    # TF2 tools
    ros-jazzy-tf2-tools \
    ros-jazzy-tf-transformations \
    # Image transport & CV bridge (OpenCV ↔ ROS)
    ros-jazzy-image-transport \
    ros-jazzy-cv-bridge \
    ros-jazzy-vision-opencv \
    # Compressed image transport
    ros-jazzy-compressed-image-transport \
    # Build tools
    python3-colcon-common-extensions \
    python3-pip \
    python3-tornado \
    # Database
    postgresql-client \
    libpq-dev \
    # Utilities
    vim nano wget curl git htop jq \
    && rm -rf /var/lib/apt/lists/*

# ---------- Python AI/ML Packages ----------
RUN pip3 install --break-system-packages --ignore-installed --no-cache-dir \
    # Object Detection
    ultralytics \
    # Speech-to-Text
    faster-whisper \
    vosk \
    # Text-to-Speech
    kokoro \
    soundfile \
    # LLM APIs
    google-generativeai \
    openai \
    # Memory & Knowledge
    sqlite-vec \
    sentence-transformers \
    # Central AI Server
    fastapi \
    uvicorn \
    websockets \
    # Experiment & Analytics
    pandas \
    matplotlib \
    # Utilities
    numpy \
    opencv-python-headless \
    pyyaml \
    requests \
    psycopg2-binary

# ---------- Node.js for Dashboard ----------
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# ---------- Auto-source ROS 2 on shell entry ----------
RUN echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc && \
    echo "# Source workspace if it exists" >> /root/.bashrc && \
    echo '[ -f /workspace/graceemo_ws/install/setup.bash ] && source /workspace/graceemo_ws/install/setup.bash' >> /root/.bashrc

# ---------- Create data directories ----------
RUN mkdir -p /workspace/gracemo_data/logs /workspace/gracemo_data/replays /workspace/gracemo_data/experiments

# ---------- Default working directory ----------
WORKDIR /workspace

# ---------- Default command ----------
CMD ["bash"]
