<?xml version="1.0" ?>
<!-- =============================================================================
  LPU Autonomous Robotics Digital Twin — Campus World (Gazebo Harmonic SDF)
  Based on publicly available LPU campus information:
    - https://www.lpude.in/about-us/tour-lpu.php
    - Official LPU infrastructure descriptions
  NOTE: Building dimensions are APPROXIMATE. See ASSUMPTIONS.md for details.
============================================================================= -->
<sdf version="1.8">
  <world name="lpu_campus">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- ===================== SCENE & LIGHTING ===================== -->
    <scene>
      <ambient>0.55 0.55 0.6 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>50 50 80 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>-50 -50 60 0 0 0</pose>
      <diffuse>0.3 0.32 0.38 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.3 -0.2 -0.8</direction>
    </light>

    <!-- ===================== GROUND PLANE ===================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material>
            <ambient>0.42 0.52 0.32 1</ambient>
            <diffuse>0.48 0.58 0.36 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== CAMPUS BOUNDARY WALL ===================== -->
    <!-- Approximate 200m x 200m campus area boundary -->
    <model name="boundary_north">
      <static>true</static>
      <pose>0 100 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>202 0.5 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>202 0.5 3</size></box></geometry>
          <material><ambient>0.65 0.55 0.40 1</ambient><diffuse>0.72 0.62 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="boundary_south">
      <static>true</static>
      <pose>0 -100 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>202 0.5 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>202 0.5 3</size></box></geometry>
          <material><ambient>0.65 0.55 0.40 1</ambient><diffuse>0.72 0.62 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="boundary_east">
      <static>true</static>
      <pose>100 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 200 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 200 3</size></box></geometry>
          <material><ambient>0.65 0.55 0.40 1</ambient><diffuse>0.72 0.62 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="boundary_west">
      <static>true</static>
      <pose>-100 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 200 3</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 200 3</size></box></geometry>
          <material><ambient>0.65 0.55 0.40 1</ambient><diffuse>0.72 0.62 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== MAIN GATE ===================== -->
    <!-- Gate 1 (Main Entrance) — south side -->
    <model name="main_gate_pillar_left">
      <static>true</static>
      <pose>-4 -100 2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 2 4</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 2 4</size></box></geometry>
          <material><ambient>0.75 0.68 0.55 1</ambient><diffuse>0.82 0.75 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="main_gate_pillar_right">
      <static>true</static>
      <pose>4 -100 2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 2 4</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.5 2 4</size></box></geometry>
          <material><ambient>0.75 0.68 0.55 1</ambient><diffuse>0.82 0.75 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== MAIN ROAD (North-South through campus) ===================== -->
    <model name="main_road">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 200 0.01</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 200 0.01</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cross road (East-West) -->
    <model name="cross_road">
      <static>true</static>
      <pose>0 20 0.005 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>200 8 0.01</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>200 8 0.01</size></box></geometry>
          <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pedestrian pathways -->
    <model name="pathway_block34_to_37">
      <static>true</static>
      <pose>-30 0 0.008 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>3 80 0.01</size></box></geometry>
          <material><ambient>0.60 0.58 0.52 1</ambient><diffuse>0.68 0.65 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pathway_east_blocks">
      <static>true</static>
      <pose>30 0 0.008 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>3 80 0.01</size></box></geometry>
          <material><ambient>0.60 0.58 0.52 1</ambient><diffuse>0.68 0.65 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== ACADEMIC BLOCKS ===================== -->
    <!-- Block 34 — Academic (approximate: 40m x 20m, 4 floors) -->
    <model name="block_34">
      <static>true</static>
      <pose>-40 -40 6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>40 20 12</size></box></geometry></collision>
