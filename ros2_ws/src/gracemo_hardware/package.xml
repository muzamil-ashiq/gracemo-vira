<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gracemo_hardware</name>
  <version>1.0.0</version>
  <description>
    GRaCEmo ViRa Hardware Abstraction Layer (HAL).
    Provides configurable adapters for STM32 MCU communication, LiDAR driver
    configuration, hardware-mode launch files, fault reporting, and a mock
    transport for automated testing.
    Strictly separated from simulation packages.
  </description>
  <maintainer email="sabarish@gracemo.ai">Sabarish</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
