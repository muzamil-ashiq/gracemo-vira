<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="apartment_floor_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Top-down perspective overview camera for 4-room floorplan -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.0 -1.5 16.0 0 1.35 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- Main Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 18 0 0 0</pose>
      <diffuse>0.90 0.90 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Warm Indoor Ambient Fill Light -->
    <light type="point" name="hall_light">
      <pose>0 0 3.5 0 0 0</pose>
      <diffuse>0.6 0.55 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.05</linear>
      </attenuation>
    </light>

    <!-- Hardwood / Tiled Floor (16m x 12m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>25 25</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>25 25</size></plane></geometry>
          <material>
            <ambient>0.72 0.68 0.62 1</ambient>
            <diffuse>0.75 0.70 0.65 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================================================================== -->
    <!-- OUTER PERIMETER WALLS (16m x 12m x 2.4m)                             -->
    <!-- ==================================================================== -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 6.0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16.2 0.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16.2 0.2 2.4</size></box></geometry><material><ambient>0.88 0.88 0.92 1</ambient><diffuse>0.88 0.88 0.92 1</diffuse></material></visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -6.0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16.2 0.2 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16.2 0.2 2.4</size></box></geometry><material><ambient>0.88 0.88 0.92 1</ambient><diffuse>0.88 0.88 0.92 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>8.0 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.0 2.4</size></box></geometry><material><ambient>0.88 0.88 0.92 1</ambient><diffuse>0.88 0.88 0.92 1</diffuse></material></visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-8.0 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.0 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 12.0 2.4</size></box></geometry><material><ambient>0.88 0.88 0.92 1</ambient><diffuse>0.88 0.88 0.92 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ==================================================================== -->
    <!-- INTERIOR CORRIDOR & DOORWAYS (1.4m WIDE ARCHWAYS)                    -->
    <!-- ==================================================================== -->
    <model name="north_hall_wall_1">
      <static>true</static>
      <pose>-5.5 1.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.15 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.0 0.15 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="north_hall_wall_2">
      <static>true</static>
      <pose>0.8 1.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.2 0.15 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.2 0.15 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="north_hall_wall_3">
      <static>true</static>
      <pose>6.2 1.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.4 0.15 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.4 0.15 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <model name="south_hall_wall_1">
      <static>true</static>
      <pose>-5.0 -1.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.0 0.15 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.0 0.15 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_hall_wall_2">
      <static>true</static>
      <pose>1.5 -1.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.6 0.15 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.6 0.15 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_hall_wall_3">
      <static>true</static>
      <pose>6.4 -1.3 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.2 0.15 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 0.15 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <model name="divider_bedroom_kitchen">
      <static>true</static>
      <pose>-0.5 3.65 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 4.7 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 4.7 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <model name="divider_study_living">
      <static>true</static>
      <pose>-0.5 -3.65 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 4.7 2.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 4.7 2.4</size></box></geometry><material><ambient>0.82 0.82 0.86 1</ambient><diffuse>0.82 0.82 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ==================================================================== -->
    <!-- 🛏️ ROOM 1: MASTER BEDROOM (Top-Left)                                 -->
    <!-- ==================================================================== -->

    <!-- Photorealistic OpenRobotics 3D Mesh Double Bed -->
    <include>
      <uri>model://bed</uri>
      <name>master_bed_3d</name>
      <pose>-5.2 4.4 0 0 0 0</pose>
    </include>

    <!-- Bedroom Wardrobe Closet -->
    <model name="bedroom_wardrobe">
      <static>true</static>
      <pose>-7.4 3.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 1.6 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.6 2.0</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Nightstand & Bedside Lamp -->
    <model name="nightstand">
      <static>true</static>
      <pose>-5.2 2.8 0.3 0 0 0</pose>
      <link name="table">
        <collision name="c"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.6</size></box></geometry><material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ==================================================================== -->
    <!-- 🍳 ROOM 2: KITCHEN & DINING (Top-Right)                              -->
    <!-- ==================================================================== -->

    <!-- Photorealistic OpenRobotics 3D Mesh Dining Table -->
    <include>
      <uri>model://table</uri>
      <name>dining_table_3d</name>
      <pose>4.2 3.8 0 0 0 0</pose>
    </include>

    <!-- Photorealistic OpenRobotics 3D Mesh Coke Can on Dining Table -->
    <include>
      <uri>model://coke_can</uri>
      <name>coke_can_3d</name>
      <pose>4.2 3.8 0.77 0 0 0</pose>
    </include>

    <!-- Photorealistic OpenRobotics 3D Dining Chairs around Table -->
    <include>
      <uri>model://chair</uri>
      <name>dining_chair_1</name>
      <pose>4.2 3.1 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://chair</uri>
      <name>dining_chair_2</name>
      <pose>4.2 4.5 0 0 0 3.14</pose>
    </include>

    <!-- Grabbable Water Bottle & Soda Can on Dining Table -->
    <model name="table_bottle">
      <pose>4.0 3.6 0.82 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder radius="0.04" length="0.22"/></geometry></collision>
        <visual name="v"><geometry><cylinder radius="0.04" length="0.22"/></geometry><material><ambient>0.1 0.6 0.9 1</ambient><diffuse>0.1 0.7 1.0 1</diffuse></material></visual>
        <inertial><mass value="0.3"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
      </link>
    </model>

    <!-- Kitchen Counter with Sink -->
    <model name="kitchen_counter">
      <static>true</static>
      <pose>6.8 4.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 2.8 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 2.8 0.9</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.9 0.9 0.92 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Photorealistic OpenRobotics 3D Mesh Refrigerator -->
    <include>
      <uri>model://refrigerator</uri>
      <name>real_fridge_3d</name>
      <pose>7.4 2.0 0 0 0 0</pose>
    </include>

    <!-- ==================================================================== -->
    <!-- 🛋️ ROOM 3: LIVING ROOM & TV (Bottom-Right)                            -->
    <!-- ==================================================================== -->

    <!-- Photorealistic OpenRobotics 3D Mesh Sectional Sofa -->
    <include>
      <uri>model://sofa</uri>
      <name>real_sofa_3d</name>
      <pose>4.2 -4.6 0 0 0 0</pose>
    </include>

    <!-- Coffee Table -->
    <model name="coffee_table">
      <static>true</static>
      <pose>4.2 -3.0 0.22 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.6 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.6 0.44</size></box></geometry><material><ambient>0.45 0.3 0.18 1</ambient><diffuse>0.5 0.35 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Media TV Entertainment Unit -->
    <model name="tv_media_unit">
      <static>true</static>
      <pose>7.4 -3.6 0 0 0 0</pose>
      <!-- Console Table -->
      <link name="console">
        <pose>0 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.5 2.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 2.0 0.5</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      </link>
      <!-- TV Screen -->
      <link name="tv_screen">
        <pose>0 0 0.95 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.08 1.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.08 1.4 0.8</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
      </link>
    </model>

    <!-- ==================================================================== -->
    <!-- 💻 ROOM 4: HOME STUDY & ROBOT LAB (Bottom-Left)                      -->
    <!-- ==================================================================== -->

    <!-- Executive Computer Desk -->
    <model name="study_workstation">
      <static>true</static>
      <pose>-4.5 -4.4 0 0 0 0</pose>
      <!-- Desk Table Top -->
      <link name="top">
        <pose>0 0 0.72 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.8 0.8 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.8 0.05</size></box></geometry><material><ambient>0.4 0.25 0.15 1</ambient><diffuse>0.48 0.3 0.18 1</diffuse></material></visual>
      </link>
      <!-- Computer Monitor on Desk -->
      <link name="monitor">
        <pose>0 -0.2 0.95 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.6 0.06 0.35</size></box></geometry><material><ambient>0.1 0.1 0.12 1</ambient></material></visual>
      </link>
      <!-- Desk Side Drawers -->
      <link name="drawers">
        <pose>0.6 0 0.35 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.5 0.7 0.68</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.7 0.68</size></box></geometry><material><ambient>0.35 0.2 0.1 1</ambient></material></visual>
      </link>
    </model>

    <!-- Photorealistic OpenRobotics 3D Mesh Bookshelf -->
    <include>
      <uri>model://bookshelf</uri>
      <name>real_bookshelf_3d</name>
      <pose>-7.4 -3.5 0 0 0 0</pose>
    </include>

  </world>
</sdf>
