      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->
    <model name='gracemo_vira'>
    <pose>-4.322 2.50 0.025 0 0 1.570796</pose>

    <link name='base_footprint'>
      <inertial>
        <pose>0.0008814270724029383 0.0025603357817418678 0.13293284365162639 0 0 0</pose>
        <mass>9.5299999999999994</mass>
        <inertia>
          <ixx>0.24901460482686261</ixx>
          <ixy>0.00050950682056663174</ixy>
          <ixz>0.002818635886673661</ixz>
          <iyy>0.25127087303252887</iyy>
          <iyz>-0.0083464386149003176</iyz>
          <izz>0.072810923819517315</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>0 0 0.14499999999999999 0 0 0</pose>
        <geometry>
          <box>
            <size>0.23999999999999999 0.20000000000000001 0.14000000000000001</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__bumper_collision_collision_1'>
        <pose>0 0 0.105 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.040000000000000001</length>
            <radius>0.20499999999999999</radius>
          </cylinder>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__front_caster_link_collision_2'>
        <pose>0.14000000000000001 0 0.025000000000000001 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025000000000000001</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>10</kd>
              <min_depth>0.0001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0</mu>
              <mu2>0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__rear_caster_link_collision_3'>
        <pose>-0.14000000000000001 0 0.025000000000000001 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025000000000000001</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>10</kd>
              <min_depth>0.0001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0</mu>
              <mu2>0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual'>
        <pose>0 0 0.13500000000000001 0 0 0</pose>
        <geometry>
