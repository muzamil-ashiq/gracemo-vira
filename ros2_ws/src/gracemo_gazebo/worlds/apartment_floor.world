<?xml version="1.0" ?>
<!--
  GRACEmo ViRa — Home Apartment Simulation
  Layout: Central hallway (Y=-1 to Y=1) connecting 4 rooms:
    Bedroom  (Top-Left)   X:-9 to  0,  Y: 1 to 7
    Study    (Top-Right)  X: 0 to  9,  Y: 1 to 7
    Kitchen  (Bot-Left)   X:-9 to  0,  Y:-7 to -1
    Living   (Bot-Right)  X: 0 to  9,  Y:-7 to -1
  Robot spawns in hallway at (0,0).
-->
<sdf version="1.6">
  <world name="gracemo_home">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.42 0.40 1</ambient>
      <background>0.3 0.3 0.35 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.0 0.0 22.0 0 1.5 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.88 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- =====================================================================
         FLOOR  18m x 14m
         ===================================================================== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>18 14 0.05</size></box></geometry></collision>
        <visual name="v">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>18 14 0.05</size></box></geometry>
          <material><ambient>0.72 0.60 0.45 1</ambient><diffuse>0.76 0.64 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         OUTER WALLS
         ===================================================================== -->
    <!-- North wall -->
    <model name="wall_north"><static>true</static>
      <link name="l"><pose>0 7.1 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>18.2 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>18.2 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <!-- South wall -->
    <model name="wall_south"><static>true</static>
      <link name="l"><pose>0 -7.1 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>18.2 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>18.2 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <!-- West wall -->
    <model name="wall_west"><static>true</static>
      <link name="l"><pose>-9.1 0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 14.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <!-- East wall -->
    <model name="wall_east"><static>true</static>
      <link name="l"><pose>9.1 0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 14.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =====================================================================
         HALLWAY WALLS  (Y=1 top, Y=-1 bottom — 2m wide central corridor)
         Each has two doorways, one per room side
         ===================================================================== -->

    <!-- North hallway wall (Y=1.0) — 3 segments with 2 doorways (1.2m each) -->
    <!-- Left segment: X=-9 to X=-4.6 -->
    <model name="hall_north_L"><static>true</static>
      <link name="l"><pose>-6.8 1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Door arch above bedroom doorway (X=-4.6 to -3.4): gap left -->
    <!-- Middle segment: X=-3.4 to X=3.4 — wall between bedroom and study minus center gap -->
    <!-- Actually: X=-9 to -4.6, gap -4.6 to -3.4, X=-3.4 to -0.1, X=0.1 to 3.4, gap 3.4 to 4.6, X=4.6 to 9 -->
    <!-- Centre divider top (between bedroom and study): X=-0.1 to 0.1 -->
    <model name="hall_north_CL"><static>true</static>
      <link name="l"><pose>-1.85 1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_north_CR"><static>true</static>
      <link name="l"><pose>1.85 1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Right segment: X=4.6 to X=9 -->
    <model name="hall_north_R"><static>true</static>
      <link name="l"><pose>6.8 1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- South hallway wall (Y=-1.0) — same pattern -->
    <model name="hall_south_L"><static>true</static>
      <link name="l"><pose>-6.8 -1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_south_CL"><static>true</static>
      <link name="l"><pose>-1.85 -1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_south_CR"><static>true</static>
      <link name="l"><pose>1.85 -1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.1 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.1 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_south_R"><static>true</static>
      <link name="l"><pose>6.8 -1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Centre divider (top half — between bedroom and study) -->
    <model name="div_top"><static>true</static>
      <link name="l"><pose>0 4.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 6.0 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.0 2.6</size></box></geometry><material><ambient>0.85 0.83 0.80 1</ambient><diffuse>0.90 0.88 0.84 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Centre divider (bottom half — between kitchen and living room) -->
    <model name="div_bot"><static>true</static>
      <link name="l"><pose>0 -4.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 6.0 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.0 2.6</size></box></geometry><material><ambient>0.85 0.83 0.80 1</ambient><diffuse>0.90 0.88 0.84 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =====================================================================
         HALLWAY CEILING strip (visual only, makes hallway feel enclosed)
         ===================================================================== -->
    <model name="hallway_ceiling"><static>true</static>
      <link name="l"><pose>0 0 2.62 0 0 0</pose>
        <visual name="v"><geometry><box><size>18 2.0 0.05</size></box></geometry>
          <material><ambient>0.92 0.90 0.88 1</ambient><diffuse>0.95 0.93 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         🛏️  BEDROOM  (Top-Left: X -9 to 0,  Y 1 to 7,  centre: -4.5, 4)
         ===================================================================== -->
    <!-- Bed -->
    <model name="master_bed"><static>true</static><pose>-6.5 5.0 0 0 0 0</pose>
      <link name="link">
        <visual name="frame"><pose>0 0 0.20 0 0 0</pose><geometry><box><size>2.0 1.6 0.40</size></box></geometry><material><ambient>0.55 0.35 0.18 1</ambient><diffuse>0.60 0.38 0.20 1</diffuse></material></visual>
        <visual name="mattress"><pose>0 0 0.44 0 0 0</pose><geometry><box><size>1.9 1.5 0.12</size></box></geometry><material><ambient>0.92 0.92 0.95 1</ambient><diffuse>0.95 0.95 0.98 1</diffuse></material></visual>
        <visual name="pillow1"><pose>0.55 0.38 0.53 0 0 0</pose><geometry><box><size>0.60 0.32 0.08</size></box></geometry><material><ambient>0.80 0.85 0.95 1</ambient></material></visual>
        <visual name="pillow2"><pose>0.55 -0.38 0.53 0 0 0</pose><geometry><box><size>0.60 0.32 0.08</size></box></geometry><material><ambient>0.80 0.85 0.95 1</ambient></material></visual>
        <visual name="headboard"><pose>-0.95 0 0.62 0 0 0</pose><geometry><box><size>0.08 1.6 0.65</size></box></geometry><material><ambient>0.50 0.32 0.16 1</ambient><diffuse>0.55 0.35 0.18 1</diffuse></material></visual>
        <collision name="col"><pose>0 0 0.25 0 0 0</pose><geometry><box><size>2.0 1.6 0.50</size></box></geometry></collision>
      </link>
    </model>
    <!-- Wardrobe -->
    <model name="wardrobe"><static>true</static>
      <link name="l"><pose>-8.6 4.0 1.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 2.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 2.2 2.0</size></box></geometry><material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.40 0.26 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Nightstand -->
    <model name="nightstand"><static>true</static>
      <link name="l"><pose>-5.3 3.2 0.30 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.50 0.50 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.50 0.50 0.60</size></box></geometry><material><ambient>0.40 0.26 0.14 1</ambient><diffuse>0.44 0.28 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =====================================================================
         🍳  KITCHEN  (Bottom-Left: X -9 to 0,  Y -7 to -1,  centre: -4.5, -4)
         ===================================================================== -->
    <!-- Counter -->
    <model name="kitchen_counter"><static>true</static>
      <link name="l"><pose>-8.0 -4.0 0.45 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.6 4.5 0.90</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 4.5 0.90</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.90 0.90 0.93 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Refrigerator -->
    <model name="refrigerator"><static>true</static><pose>-1.5 -6.2 0 0 0 0</pose>
      <link name="link">
        <visual name="body"><pose>0 0 0.87 0 0 0</pose><geometry><box><size>0.70 0.68 1.74</size></box></geometry><material><ambient>0.88 0.88 0.90 1</ambient><diffuse>0.92 0.92 0.94 1</diffuse></material></visual>
        <visual name="handle"><pose>0.36 0 1.10 0 0 0</pose><geometry><box><size>0.03 0.04 0.35</size></box></geometry><material><ambient>0.65 0.65 0.68 1</ambient></material></visual>
        <collision name="col"><pose>0 0 0.87 0 0 0</pose><geometry><box><size>0.70 0.68 1.74</size></box></geometry></collision>
      </link>
    </model>
    <!-- Dining table -->
    <model name="dining_table"><static>true</static><pose>-4.5 -4.0 0 0 0 0</pose>
      <link name="link">
        <visual name="top"><pose>0 0 0.78 0 0 0</pose><geometry><box><size>1.5 0.9 0.04</size></box></geometry><material><ambient>0.55 0.36 0.18 1</ambient><diffuse>0.60 0.40 0.20 1</diffuse></material></visual>
        <collision name="top_c"><pose>0 0 0.78 0 0 0</pose><geometry><box><size>1.5 0.9 0.04</size></box></geometry></collision>
        <visual name="leg1"><pose>0.66 0.38 0.39 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.78</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg2"><pose>-0.66 0.38 0.39 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.78</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg3"><pose>0.66 -0.38 0.39 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.78</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg4"><pose>-0.66 -0.38 0.39 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>0.78</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
      </link>
    </model>
    <!-- Chairs -->
    <model name="chair_1"><static>true</static><pose>-4.5 -2.8 0 0 0 3.14</pose>
      <link name="link">
        <visual name="seat"><pose>0 0 0.44 0 0 0</pose><geometry><box><size>0.46 0.46 0.06</size></box></geometry><material><ambient>0.42 0.28 0.14 1</ambient><diffuse>0.48 0.32 0.16 1</diffuse></material></visual>
        <visual name="back"><pose>0 -0.22 0.74 0 0 0</pose><geometry><box><size>0.46 0.04 0.55</size></box></geometry><material><ambient>0.40 0.26 0.12 1</ambient></material></visual>
        <visual name="leg1"><pose>0.20 0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg2"><pose>-0.20 0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg3"><pose>0.20 -0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg4"><pose>-0.20 -0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <collision name="c"><pose>0 0 0.44 0 0 0</pose><geometry><box><size>0.46 0.46 0.06</size></box></geometry></collision>
      </link>
    </model>
    <model name="chair_2"><static>true</static><pose>-4.5 -5.2 0 0 0 0</pose>
      <link name="link">
        <visual name="seat"><pose>0 0 0.44 0 0 0</pose><geometry><box><size>0.46 0.46 0.06</size></box></geometry><material><ambient>0.42 0.28 0.14 1</ambient><diffuse>0.48 0.32 0.16 1</diffuse></material></visual>
        <visual name="back"><pose>0 0.22 0.74 0 0 0</pose><geometry><box><size>0.46 0.04 0.55</size></box></geometry><material><ambient>0.40 0.26 0.12 1</ambient></material></visual>
        <visual name="leg1"><pose>0.20 0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg2"><pose>-0.20 0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg3"><pose>0.20 -0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <visual name="leg4"><pose>-0.20 -0.20 0.22 0 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.44</length></cylinder></geometry><material><ambient>0.30 0.30 0.30 1</ambient></material></visual>
        <collision name="c"><pose>0 0 0.44 0 0 0</pose><geometry><box><size>0.46 0.46 0.06</size></box></geometry></collision>
      </link>
    </model>

    <!-- =====================================================================
         🛋️  LIVING ROOM  (Bottom-Right: X 0 to 9,  Y -7 to -1,  centre: 4.5, -4)
         ===================================================================== -->
    <!-- Sofa -->
    <model name="living_sofa"><static>true</static><pose>4.5 -5.5 0 0 0 0</pose>
      <link name="link">
        <visual name="seat"><pose>0 0 0.22 0 0 0</pose><geometry><box><size>2.2 0.9 0.44</size></box></geometry><material><ambient>0.20 0.25 0.55 1</ambient><diffuse>0.22 0.28 0.60 1</diffuse></material></visual>
        <visual name="back"><pose>0 -0.42 0.60 0 0 0</pose><geometry><box><size>2.2 0.12 0.55</size></box></geometry><material><ambient>0.18 0.22 0.52 1</ambient></material></visual>
        <visual name="arm_l"><pose>1.08 0 0.44 0 0 0</pose><geometry><box><size>0.12 0.9 0.44</size></box></geometry><material><ambient>0.16 0.20 0.48 1</ambient></material></visual>
        <visual name="arm_r"><pose>-1.08 0 0.44 0 0 0</pose><geometry><box><size>0.12 0.9 0.44</size></box></geometry><material><ambient>0.16 0.20 0.48 1</ambient></material></visual>
        <collision name="col"><pose>0 0 0.22 0 0 0</pose><geometry><box><size>2.2 0.9 0.44</size></box></geometry></collision>
      </link>
    </model>
    <!-- Coffee table -->
    <model name="coffee_table"><static>true</static>
      <link name="l"><pose>4.5 -3.5 0.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.1 0.6 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.1 0.6 0.44</size></box></geometry><material><ambient>0.42 0.28 0.16 1</ambient><diffuse>0.48 0.32 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <!-- TV unit -->
    <model name="tv_unit"><static>true</static><pose>8.6 -4.0 0 0 0 0</pose>
      <link name="console"><pose>0 0 0.25 0 0 0</pose><collision name="c"><geometry><box><size>0.4 2.0 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 2.0 0.5</size></box></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual></link>
      <link name="screen"><pose>0 0 0.95 0 0 0</pose><collision name="c"><geometry><box><size>0.06 1.4 0.80</size></box></geometry></collision><visual name="v"><geometry><box><size>0.06 1.4 0.80</size></box></geometry><material><ambient>0.03 0.03 0.04 1</ambient><diffuse>0.05 0.05 0.06 1</diffuse></material></visual></link>
    </model>
    <!-- Bowl on coffee table -->
    <model name="bowl"><pose>4.5 -3.5 0.48 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry><material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.90 0.86 0.80 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.09</radius><length>0.06</length></cylinder></geometry></collision>
        <inertial><mass>0.2</mass></inertial>
      </link>
    </model>

    <!-- =====================================================================
         💻  STUDY  (Top-Right: X 0 to 9,  Y 1 to 7,  centre: 4.5, 4)
         ===================================================================== -->
    <!-- Bookshelf -->
    <model name="bookshelf"><static>true</static><pose>8.6 5.5 0 0 0 0</pose>
      <link name="link">
        <visual name="back"><pose>0 0 0.9 0 0 0</pose><geometry><box><size>0.1 1.8 1.8</size></box></geometry><material><ambient>0.38 0.24 0.14 1</ambient><diffuse>0.44 0.28 0.16 1</diffuse></material></visual>
        <collision name="bc"><pose>0 0 0.9 0 0 0</pose><geometry><box><size>0.1 1.8 1.8</size></box></geometry></collision>
        <visual name="shelf1"><pose>0 0 0.30 0 0 0</pose><geometry><box><size>0.35 1.8 0.03</size></box></geometry><material><ambient>0.42 0.28 0.16 1</ambient></material></visual>
