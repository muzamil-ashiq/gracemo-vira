         ===================================================================== -->

      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->

      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->
    <model name='gracemo_vira'>
    <pose>-5.0 2.2 0.005 0 0 -1.570796</pose>
    <link name='base_footprint'>
      <inertial>
        <pose>0.0027027027027027029 0 0.13518018018018019 0 0 0</pose>
        <mass>22.199999999999999</mass>
        <inertia>
          <ixx>0.42907927927927919</ixx>
          <ixy>0</ixy>
          <ixz>-0.0011891891891891891</ixz>
          <iyy>0.78391711711711709</iyy>
          <iyz>0</iyz>
          <izz>1.0038378378378381</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__chassis_collision_collision'>
        <pose>0 0 0.16500000000000001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.57999999999999996 0.40000000000000002 0.17000000000000001</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__bumper_link_collision_1'>
        <pose>0.29999999999999999 0 0.155 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.38 0.080000000000000002</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual'>
        <pose>0 0 0.115 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://gracemo_description/meshes/base_link_visual.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name='bumper_contact' type='contact'>
        <contact>
          <collision>base_footprint_fixed_joint_lump__bumper_link_collision_1</collision>
        </contact>
        <topic>/bumper/contacts</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <pose>0.29999999999999999 0 0.155 0 0 0</pose>
      </sensor>
      <sensor name='imu' type='imu'>
        <topic>/imu/data</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <pose>0 0 0.16500000000000001 0 0 0</pose>
        <imu/>
      </sensor>
      <sensor name='tof_front_left' type='gpu_lidar'>
        <topic>/tof/front_left</topic>
        <update_rate>25</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.14999999999999999</min_angle>
              <max_angle>0.14999999999999999</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>2</max>
            <resolution>0.0050000000000000001</resolution>
