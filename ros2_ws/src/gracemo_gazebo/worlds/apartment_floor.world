<?xml version="1.0" ?>
<!--
  GRACEmo ViRa — Photorealistic 3D Apartment Simulation (Gazebo Harmonic 8)
  Layout: Central hallway (Y=-1.0 to Y=+1.0, length 18m) connecting 4 distinct rooms:
    - Bedroom     (Top-Left,    X:-9 to  0, Y: 1 to  7) -> doorway at X=-5.0, Y=1.0
    - Study       (Top-Right,   X: 0 to  9, Y: 1 to  7) -> doorway at X=+5.0, Y=1.0
    - Kitchen     (Bottom-Left, X:-9 to  0, Y:-7 to -1) -> doorway at X=-5.0, Y=-1.0
    - Living Room (Bottom-Right,X: 0 to  9, Y:-7 to -1) -> doorway at X=+5.0, Y=-1.0
-->
<sdf version="1.6">
  <world name="gracemo_home">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World System Plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.48 0.45 0.42 1</ambient>
      <background>0.3 0.3 0.35 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-2.5 -4.5 3.5 0 0.55 1.1</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.92 0.90 0.88 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- =====================================================================
         FLOOR (18m x 14m Wood Tone)
         ===================================================================== -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>18 14 0.05</size></box></geometry></collision>
        <visual name="v">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry><box><size>18 14 0.05</size></box></geometry>
          <material><ambient>0.72 0.60 0.45 1</ambient><diffuse>0.76 0.64 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         OUTER BOUNDARY WALLS
         ===================================================================== -->
    <model name="wall_north"><static>true</static>
      <link name="l"><pose>0 7.1 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>18.2 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>18.2 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south"><static>true</static>
      <link name="l"><pose>0 -7.1 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>18.2 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>18.2 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west"><static>true</static>
      <link name="l"><pose>-9.1 0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 14.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east"><static>true</static>
      <link name="l"><pose>9.1 0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 14.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 14.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =====================================================================
         ROOM DIVIDING WALLS
         ===================================================================== -->
    <!-- Bedroom <-> Study Dividing Wall -->
    <model name="wall_bedroom_study"><static>true</static>
      <link name="l"><pose>0 4.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 6.0 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.0 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Kitchen <-> Living Room Dividing Wall -->
    <model name="wall_kitchen_living"><static>true</static>
      <link name="l"><pose>0 -4.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 6.0 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.0 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =====================================================================
         HALLWAY WALLS (Y = +1.0 and Y = -1.0)
         ===================================================================== -->
    <!-- North Hallway Wall -->
    <model name="hall_north_west"><static>true</static>
      <link name="l"><pose>-7.3 1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_north_middle"><static>true</static>
      <link name="l"><pose>0.0 1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.8 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.8 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_north_east"><static>true</static>
      <link name="l"><pose>7.3 1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- South Hallway Wall -->
    <model name="hall_south_west"><static>true</static>
      <link name="l"><pose>-7.3 -1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_south_middle"><static>true</static>
      <link name="l"><pose>0.0 -1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.8 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.8 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>
    <model name="hall_south_east"><static>true</static>
      <link name="l"><pose>7.3 -1.0 1.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>3.4 0.2 2.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.4 0.2 2.6</size></box></geometry><material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.92 0.90 0.86 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =====================================================================
         🛏️  ROOM 1: BEDROOM  (Top-Left: X -9 to 0, Y 1 to 7)
         ===================================================================== -->
    <!-- 3D PBR Master Bed -->
    <include>
      <uri>model://bed</uri>
      <name>master_bed</name>
      <static>true</static>
      <pose>-6.0 5.0 0 0 0 0</pose>
    </include>
    <!-- Wardrobe -->
    <model name="wardrobe"><static>true</static>
      <link name="l"><pose>-8.6 4.0 1.0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 2.2 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 2.2 2.0</size></box></geometry><material><ambient>0.35 0.22 0.12 1</ambient><diffuse>0.40 0.26 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Nightstand -->
    <model name="nightstand"><static>true</static>
      <link name="l"><pose>-4.2 3.4 0.30 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.50 0.50 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.50 0.50 0.60</size></box></geometry><material><ambient>0.40 0.26 0.14 1</ambient><diffuse>0.44 0.28 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Physical Book in Bedroom (Target for Manipulation) -->
    <model name="book_math">
      <pose>-4.20 3.28 0.62 0 0 1.570796</pose>
      <link name="link">
        <inertial>
          <mass>0.20</mass>
          <inertia>
            <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.14 0.06 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>3.5</mu>
                <mu2>3.5</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>
                <min_depth>0.0</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="cover">
          <geometry><box><size>0.14 0.06 0.04</size></box></geometry>
          <material>
            <ambient>0.10 0.20 0.60 1</ambient>
            <diffuse>0.15 0.30 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
         🎥 THIRD-PERSON BEDROOM OVERVIEW CAMERA
         High-angle perspective: captures robot base, arm, nightstand, & book
         ===================================================================== -->
    <model name="bedroom_overview_camera">
      <static>true</static>
      <pose>-2.80 2.00 1.25 0 0.4324 2.5616</pose>
      <link name="link">
        <visual name="housing">
          <geometry>
            <box><size>0.08 0.08 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <sensor name="bedroom_overview_camera" type="camera">
          <topic>/bedroom_overview_camera/image_raw</topic>
          <update_rate>15.0</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.396263</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- =====================================================================
         🍳  ROOM 2: KITCHEN  (Bottom-Left: X -9 to 0, Y -7 to -1)
         ===================================================================== -->
    <!-- 3D Refrigerator -->
    <include>
      <uri>model://refrigerator</uri>
      <name>refrigerator</name>
      <static>true</static>
      <pose>-1.5 -6.2 0 0 0 0</pose>
    </include>
    <!-- 3D Dining Table -->
    <include>
      <uri>model://table</uri>
      <name>dining_table</name>
      <static>true</static>
      <pose>-4.5 -4.0 0 0 0 0</pose>
    </include>
    <!-- 3D Chairs -->
    <include>
      <uri>model://chair</uri>
      <name>chair_1</name>
      <static>true</static>
      <pose>-4.5 -3.0 0 0 0 3.14</pose>
    </include>
    <include>
      <uri>model://chair</uri>
      <name>chair_2</name>
      <static>true</static>
      <pose>-4.5 -5.0 0 0 0 0</pose>
    </include>
    <!-- Kitchen Counter -->
    <model name="kitchen_counter"><static>true</static>
      <link name="l"><pose>-8.0 -4.0 0.45 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.6 4.5 0.90</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 4.5 0.90</size></box></geometry><material><ambient>0.85 0.85 0.88 1</ambient><diffuse>0.90 0.90 0.93 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =====================================================================
         🛋️  ROOM 3: LIVING ROOM  (Bottom-Right: X 0 to 9, Y -7 to -1)
         ===================================================================== -->
    <!-- 3D Sofa -->
    <include>
      <uri>model://sofa</uri>
      <name>living_sofa</name>
      <static>true</static>
      <pose>4.5 -5.2 0 0 0 0</pose>
    </include>
    <!-- Coffee Table -->
    <model name="coffee_table"><static>true</static>
      <link name="l"><pose>4.5 -3.5 0.22 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.1 0.6 0.44</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.1 0.6 0.44</size></box></geometry><material><ambient>0.42 0.28 0.16 1</ambient><diffuse>0.48 0.32 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <!-- TV unit -->
    <model name="tv_unit"><static>true</static><pose>8.6 -4.0 0 0 0 0</pose>
      <link name="console"><pose>0 0 0.25 0 0 0</pose><collision name="c"><geometry><box><size>0.4 2.0 0.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 2.0 0.5</size></box></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual></link>
      <link name="screen"><pose>0 0 0.95 0 0 0</pose><collision name="c"><geometry><box><size>0.06 1.4 0.80</size></box></geometry></collision><visual name="v"><geometry><box><size>0.06 1.4 0.80</size></box></geometry><material><ambient>0.03 0.03 0.04 1</ambient><diffuse>0.05 0.05 0.06 1</diffuse></material></visual></link>
    </model>
    <!-- 3D Bowl on Coffee Table -->
    <include>
      <uri>model://bowl</uri>
      <name>bowl</name>
      <static>true</static>
      <pose>4.5 -3.5 0.45 0 0 0</pose>
    </include>

    <!-- =====================================================================
         💻  ROOM 4: STUDY  (Top-Right: X 0 to 9, Y 1 to 7)
         ===================================================================== -->
    <!-- 3D Bookshelf -->
    <include>
      <uri>model://bookshelf</uri>
      <name>bookshelf</name>
      <static>true</static>
      <pose>8.5 5.5 0 0 0 0</pose>
    </include>
    <!-- Study Desk -->
    <model name="study_desk"><static>true</static><pose>4.5 5.5 0 0 0 0</pose>
      <link name="top"><pose>0 0 0.73 0 0 0</pose><collision name="c"><geometry><box><size>1.8 0.8 0.04</size></box></geometry></collision><visual name="v"><geometry><box><size>1.8 0.8 0.04</size></box></geometry><material><ambient>0.38 0.24 0.14 1</ambient><diffuse>0.44 0.28 0.16 1</diffuse></material></visual></link>
      <link name="leg1"><pose>0.80 0.35 0.36 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual></link>
      <link name="leg2"><pose>-0.80 0.35 0.36 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual></link>
      <link name="leg3"><pose>0.80 -0.35 0.36 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual></link>
      <link name="leg4"><pose>-0.80 -0.35 0.36 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.025</radius><length>0.72</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual></link>
    </model>
    <!-- Monitor -->
    <model name="monitor"><static>true</static><pose>4.5 5.85 0.97 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.55 0.05 0.32</size></box></geometry></collision><visual name="v"><geometry><box><size>0.55 0.05 0.32</size></box></geometry><material><ambient>0.08 0.08 0.10 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <!-- 3D Cardboard Box -->
    <include>
      <uri>model://cardboard_box</uri>
      <name>cardboard_box</name>
      <static>true</static>
      <pose>1.5 6.0 0 0 0 0</pose>
    </include>
    <!-- 3D Coke Can -->
    <include>
      <uri>model://coke_can</uri>
      <name>coke_can</name>
      <static>false</static>
      <pose>4.0 5.5 0.76 0 0 0</pose>
    </include>

      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->

      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->

      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->

      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->

      <!-- =====================================================================
