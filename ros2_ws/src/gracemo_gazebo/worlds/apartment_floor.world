      <!-- =====================================================================
         🤖 GRaCEmo ViRa ROBOT MODEL
         ===================================================================== -->
    <model name='gracemo_vira'>
    <link name='base_footprint'>
      <inertial>
        <pose>-0.0049068215041452416 0 0.01935362849227687 0 0 0</pose>
        <mass>1.4869095999999999</mass>
        <inertia>
          <ixx>0.011266957534929411</ixx>
          <ixy>-4.7576583000000001e-05</ixy>
          <ixz>0.00093347291652034776</ixz>
          <iyy>0.01161737136523517</iyy>
          <iyz>-3.5422299000000002e-06</iyz>
          <izz>0.01604387083030576</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>-0.064000000000000001 0 0.057000000000000002 0 0 0</pose>
        <geometry>
          <box>
            <size>0.26600000000000001 0.26600000000000001 0.094</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__camera_link_collision_1'>
        <pose>0.067000000000000004 0 0.111 0 0 0</pose>
        <geometry>
          <box>
            <size>0.012 0.13200000000000001 0.02</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__base_scan_collision_2'>
        <pose>-0.049000000000000002 0 0.1255 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.0315</length>
            <radius>0.055</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual'>
        <pose>-0.064000000000000001 0 0.01 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://turtlebot3_description/meshes/bases/waffle_base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0 0.75000006 1 1</diffuse>
          <ambient>0 0.75000006 1 1</ambient>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__camera_link_visual_1'>
        <pose>0.064000000000000001 -0.065000000000000002 0.104 1.5700000000000001 -5.5511151231257827e-17 1.5700000000000001</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://turtlebot3_description/meshes/sensors/r200.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__base_scan_visual_2'>
        <pose>-0.064000000000000001 0 0.13200000000000001 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://turtlebot3_description/meshes/sensors/lds.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.25 0.25 0.25 1</diffuse>
          <ambient>0.25 0.25 0.25 1</ambient>
        </material>
      </visual>
      <sensor name='camera' type='camera'>
        <topic>/camera/image_raw</topic>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.050000000000000003</near>
            <far>15</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <pose>0.069000000000000006 -0.047 0.11700000000000001 0 0 0</pose>
      </sensor>
      <sensor name='lidar' type='gpu_lidar'>
        <topic>/scan</topic>
        <update_rate>15</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415899999999999</min_angle>
              <max_angle>3.1415899999999999</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <pose>-0.064000000000000001 0 0.13200000000000001 0 0 0</pose>
      </sensor>
    </link>
    <joint name='caster_back_left_joint' type='fixed'>
      <pose relative_to='base_footprint'>-0.17699999999999999 0.064000000000000001 0.0060000000000000001 -1.5700000000000001 0 0</pose>
      <parent>base_footprint</parent>
      <child>caster_back_left_link</child>
      <axis>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.20000000000000001</erp>
          </limit>
        </ode>
      </physics>
    </joint>
    <link name='caster_back_left_link'>
      <pose relative_to='caster_back_left_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
