<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================================== -->
  <!-- Modern Gazebo Sim (Ignition/Fortress) Systems Plugins                    -->
  <!-- ======================================================================== -->

  <gazebo>
    <!-- Scene Broadcaster (Required for rendering) -->
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />

    <!-- Sensor System (Required for Camera, Lidar, IMU) -->
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU System -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu" />

    <!-- Joint State Publisher System -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher" />

    <!-- Differential Drive System -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.065</wheel_radius>
      <max_wheel_torque>200.0</max_wheel_torque>
      <max_linear_acceleration>20.0</max_linear_acceleration>
      <max_angular_acceleration>20.0</max_angular_acceleration>
      <min_linear_velocity>-2.0</min_linear_velocity>
      <max_linear_velocity>2.0</max_linear_velocity>
      <min_angular_velocity>-5.0</min_angular_velocity>
      <max_angular_velocity>5.0</max_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Left Shoulder Pitch Joint Position Controller -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_shoulder_pitch_joint</joint_name>
      <topic>/left_arm/shoulder_cmd</topic>
      <p_gain>30.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>1.5</d_gain>
    </plugin>

    <!-- Right Shoulder Pitch Joint Position Controller -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_shoulder_pitch_joint</joint_name>
      <topic>/right_arm/shoulder_cmd</topic>
      <p_gain>30.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>1.5</d_gain>
    </plugin>

    <!-- Left Elbow Joint Position Controller -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_elbow_joint</joint_name>
      <topic>/left_arm/elbow_cmd</topic>
      <p_gain>20.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>1.0</d_gain>
    </plugin>

    <!-- Right Elbow Joint Position Controller -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_elbow_joint</joint_name>
      <topic>/right_arm/elbow_cmd</topic>
      <p_gain>20.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>1.0</d_gain>
    </plugin>

    <!-- Head Pan & Tilt Position Controllers -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>neck_pan_joint</joint_name>
      <topic>/head/pan_cmd</topic>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>

    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>head_tilt_joint</joint_name>
      <topic>/head/tilt_cmd</topic>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.5</d_gain>
    </plugin>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- 2D LiDAR Sensor Definition                                               -->
  <!-- ======================================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>15.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- RGB Camera Sensor Definition                                             -->
  <!-- ======================================================================== -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/image_raw</topic>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.15</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- IMU Sensor Definition                                                    -->
  <!-- ======================================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu/data</topic>
      <update_rate>50.0</update_rate>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

</robot>
