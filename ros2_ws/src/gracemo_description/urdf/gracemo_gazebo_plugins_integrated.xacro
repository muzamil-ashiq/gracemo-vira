<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================================== -->
  <!-- Wheel Surface Contact & Traction Parameters                              -->
  <!-- ======================================================================== -->
  <xacro:macro name="wheel_gazebo_physics" params="prefix">
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.002</minDepth>
      <maxVel>1.5</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_gazebo_physics prefix="front_left" />
  <xacro:wheel_gazebo_physics prefix="front_right" />
  <xacro:wheel_gazebo_physics prefix="rear_left" />
  <xacro:wheel_gazebo_physics prefix="rear_right" />

  <gazebo reference="base_link">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- Sensors: Planar LiDAR (GPU-Accelerated Ray Sensor)                       -->
  <!-- ======================================================================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <update_rate>15.0</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- Sensors: RGB Camera Sensor                                              -->
  <!-- ======================================================================== -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <gz_frame_id>camera_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/image_raw</topic>
      <update_rate>30.0</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- Sensors: Depth Camera Sensor                                             -->
  <!-- ======================================================================== -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <gz_frame_id>camera_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>/camera/depth_image</topic>
      <update_rate>15.0</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.2</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- Sensors: IMU Sensor                                                      -->
  <!-- ======================================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu/data</topic>
      <update_rate>50.0</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ======================================================================== -->
  <!-- Gazebo Harmonic System Plugins                                           -->
  <!-- ======================================================================== -->
  <gazebo>
    <!-- Four-Wheel Differential / Skid-Steer Drive Plugin -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.570</wheel_separation>
      <wheel_radius>0.115</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Joint State Publisher Plugin -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>

    <!-- Articulated Waist Pitch Joint Position Controller -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>waist_pitch_joint</joint_name>
      <topic>/waist/pitch/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>800</p_gain>
      <i_gain>12</i_gain>
      <d_gain>20</d_gain>
      <cmd_max>80</cmd_max>
      <cmd_min>-80</cmd_min>
    </plugin>

    <!-- 2-DOF Active Head / Neck Joint Position Controllers -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>neck_pan_joint</joint_name>
      <topic>/head/pan/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>10.0</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>0.1</d_gain>
      <cmd_max>8.0</cmd_max>
      <cmd_min>-8.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>neck_tilt_joint</joint_name>
      <topic>/head/tilt/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>12.0</p_gain>
      <i_gain>0.2</i_gain>
      <d_gain>0.1</d_gain>
      <cmd_max>8.0</cmd_max>
      <cmd_min>-8.0</cmd_min>
    </plugin>

    <!-- 7-DOF Right Arm Joint Position Controllers -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_shoulder_yaw_joint</joint_name>
      <topic>/arm/joint_1/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>60.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.4</d_gain>
      <cmd_max>25.0</cmd_max>
      <cmd_min>-25.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_shoulder_pitch_joint</joint_name>
      <topic>/arm/joint_2/cmd_pos</topic>
      <initial_position>0.90</initial_position>
      <p_gain>75.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.4</d_gain>
      <cmd_max>25.0</cmd_max>
      <cmd_min>-25.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_shoulder_roll_joint</joint_name>
      <topic>/arm/joint_3/cmd_pos</topic>
      <initial_position>0.20</initial_position>
      <p_gain>50.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.4</d_gain>
      <cmd_max>25.0</cmd_max>
      <cmd_min>-25.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_elbow_pitch_joint</joint_name>
      <topic>/arm/joint_4/cmd_pos</topic>
      <initial_position>-1.25</initial_position>
      <p_gain>40.0</p_gain>
      <i_gain>1.0</i_gain>
      <d_gain>0.4</d_gain>
      <cmd_max>15.0</cmd_max>
      <cmd_min>-15.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_wrist_pitch_joint</joint_name>
      <topic>/arm/joint_5/cmd_pos</topic>
      <initial_position>0.60</initial_position>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.005</d_gain>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_wrist_yaw_joint</joint_name>
      <topic>/arm/joint_6/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>15.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.005</d_gain>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_wrist_roll_joint</joint_name>
      <topic>/arm/joint_7/cmd_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>5.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.05</d_gain>
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>finger_left_joint</joint_name>
      <topic>/hand/left_finger/cmd_pos</topic>
      <initial_position>0.015</initial_position>
      <p_gain>80.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.00</d_gain>
      <cmd_max>15.0</cmd_max>
      <cmd_min>-15.0</cmd_min>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>finger_right_joint</joint_name>
      <topic>/hand/right_finger/cmd_pos</topic>
      <initial_position>0.015</initial_position>
      <p_gain>80.0</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.00</d_gain>
      <cmd_max>15.0</cmd_max>
      <cmd_min>-15.0</cmd_min>
    </plugin>
  </gazebo>

</robot>
