<?xml version="1.0"?>
<robot name="gracemo_vira" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================================== -->
  <!-- Configuration Arguments                                                  -->
  <!-- ======================================================================== -->
  <xacro:arg name="description_pkg" default="gracemo_description" />
  <xacro:property name="pkg" value="$(arg description_pkg)" />
  <xacro:arg name="arm_mode" default="articulated" />
  <xacro:property name="arm_mode" value="$(arg arm_mode)" />

  <!-- Include Sub-files -->
  <xacro:include filename="$(find ${pkg})/urdf/gazebo_plugins.xacro" />
  <xacro:include filename="$(find ${pkg})/urdf/materials.xacro" />

  <!-- ======================================================================== -->
  <!-- Kinematic & Physical Constants (Derived from Blender Master Model)        -->
  <!-- ======================================================================== -->
  <xacro:property name="wheel_radius" value="0.115" />
  <xacro:property name="wheel_width"  value="0.100" />
  <xacro:property name="track_width"  value="0.570" />
  <xacro:property name="wheelbase"    value="0.440" />
  <xacro:property name="half_track"   value="${track_width / 2.0}" />   <!-- 0.285 -->
  <xacro:property name="half_base"    value="${wheelbase / 2.0}" />     <!-- 0.220 -->

  <!-- Deck / Waist Joint Height: Deck is at Z=0.320m world; axle is at Z=0.115m -->
  <xacro:property name="deck_z"       value="0.205" />

  <!-- Neck Joint Height: Neck is at Z=0.905m world; deck is at Z=0.320m -->
  <xacro:property name="neck_z"       value="0.585" />

  <!-- Shoulder Joint Height: Shoulder is at Z=0.805m world; deck is at Z=0.320m -->
  <xacro:property name="shoulder_z"   value="0.485" />
  <xacro:property name="shoulder_y"   value="0.215" />

  <!-- ======================================================================== -->
  <!-- Root Links: base_footprint and base_link                                  -->
  <!-- ======================================================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <!-- Axle center is exactly wheel_radius above ground contact -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <link name="base_link">
    <!-- Visual: Master Blender Base Geometry (Lower, Upper, Lightbar, Accents) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/base_link_visual.obj" />
      </geometry>
    </visual>

    <!-- Collision: Clean Box Geometry (80mm ground clearance preserved) -->
    <collision name="chassis_collision">
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.58 0.40 0.17" />
      </geometry>
    </collision>

    <!-- Inertial: Low Center of Mass for Dynamic Stability -->
    <inertial>
      <origin xyz="0.0 0.0 0.02" rpy="0 0 0" />
      <mass value="22.0" />
      <inertia ixx="0.428" ixy="0.0" ixz="0.0"
               iyy="0.765" iyz="0.0"
               izz="0.985" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Base Sensors & Bumpers (Preserving Frame Hierarchy)                      -->
  <!-- ======================================================================== -->
  <link name="bumper_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.02 0.38 0.08" /></geometry>
    </collision>
    <inertial><mass value="0.2" /><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" /></inertial>
  </link>
  <joint name="bumper_joint" type="fixed">
    <parent link="base_link" />
    <child link="bumper_link" />
    <origin xyz="0.30 0 0.04" rpy="0 0 0" />
  </joint>

  <link name="tof_front_left_link" />
  <joint name="tof_front_left_joint" type="fixed">
    <parent link="base_link" />
    <child link="tof_front_left_link" />
    <origin xyz="0.29 0.15 0.04" rpy="0 0 0.26" />
  </joint>

  <link name="tof_front_right_link" />
  <joint name="tof_front_right_joint" type="fixed">
    <parent link="base_link" />
    <child link="tof_front_right_link" />
    <origin xyz="0.29 -0.15 0.04" rpy="0 0 -0.26" />
  </joint>

  <link name="tof_rear_link" />
  <joint name="tof_rear_joint" type="fixed">
    <parent link="base_link" />
    <child link="tof_rear_link" />
    <origin xyz="-0.29 0 0.04" rpy="0 0 3.14159" />
  </joint>

  <link name="imu_link" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.05" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- 4-Wheel Drive Assembly Macro                                             -->
  <!-- ======================================================================== -->
  <xacro:macro name="wheel_unit" params="prefix x_sign y_sign mesh_file">
    <link name="${prefix}_wheel_link">
      <!-- Visual: Tire + Accent Ring + Hub Mesh -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://${pkg}/meshes/${mesh_file}" />
        </geometry>
      </visual>

      <!-- Collision: High-fidelity cylindrical contact -->
      <collision name="${prefix}_wheel_collision">
        <origin xyz="0 0 0" rpy="1.5707963 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>

      <!-- Inertial Properties (Cylinder spinning on Y) -->
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.8" />
        <inertia ixx="0.00745" ixy="0" ixz="0"
                 iyy="0.01190" iyz="0"
                 izz="0.00745" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${x_sign * half_base} ${y_sign * half_track} 0.0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.1" friction="0.02" />
    </joint>
  </xacro:macro>

  <xacro:wheel_unit prefix="front_left"  x_sign="1"  y_sign="1"  mesh_file="wheel_front_left_visual.obj" />
  <xacro:wheel_unit prefix="front_right" x_sign="1"  y_sign="-1" mesh_file="wheel_front_right_visual.obj" />
  <xacro:wheel_unit prefix="rear_left"   x_sign="-1" y_sign="1"  mesh_file="wheel_rear_left_visual.obj" />
  <xacro:wheel_unit prefix="rear_right"  x_sign="-1" y_sign="-1" mesh_file="wheel_rear_right_visual.obj" />

  <!-- ======================================================================== -->
  <!-- Torso & Articulated Waist Joint                                          -->
  <!-- ======================================================================== -->
  <joint name="waist_pitch_joint" type="revolute">
    <parent link="base_link" />
    <child link="torso_link" />
    <origin xyz="0 0 ${deck_z}" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.5236" upper="0.5236" effort="100.0" velocity="2.0" />
    <dynamics damping="1.5" friction="0.2" />
  </joint>

  <link name="torso_link">
    <!-- Visual: Platform, Pedestal, Waist, Chest, Accents, Sensors -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/torso_link_visual.obj" />
      </geometry>
    </visual>

    <!-- Collision: Upper Body Protective Hull -->
    <collision name="torso_collision">
      <origin xyz="0 0 0.24" rpy="0 0 0" />
      <geometry>
        <box size="0.32 0.36 0.44" />
      </geometry>
    </collision>

    <!-- Inertial: Compute units, batteries, upper deck structure -->
    <inertial>
      <origin xyz="0.0 0.0 0.20" rpy="0 0 0" />
      <mass value="7.0" />
      <inertia ixx="0.180" ixy="0.0" ixz="0.0"
               iyy="0.180" iyz="0.0"
               izz="0.120" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Head & 2-DOF Active Neck Pan / Tilt Assembly                            -->
  <!-- ======================================================================== -->
  <joint name="neck_pan_joint" type="revolute">
    <parent link="torso_link" />
    <child link="neck_pan_link" />
    <origin xyz="0 0 ${neck_z}" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="15.0" velocity="3.0" />
    <dynamics damping="0.2" friction="0.05" />
  </joint>

  <link name="neck_pan_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
  </link>

  <joint name="neck_tilt_joint" type="revolute">
    <parent link="neck_pan_link" />
    <child link="head_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.5236" upper="0.7854" effort="15.0" velocity="3.0" />
    <dynamics damping="0.2" friction="0.05" />
  </joint>

  <link name="head_link">
    <!-- Visual: Head Shell, Bezel, OLED Face Screen, Glowing Eyes, Lidar, Ears -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/head_link_visual.obj" />
      </geometry>
    </visual>

    <!-- Collision: Spherical Head Enclosure -->
    <collision name="head_collision">
      <origin xyz="0 0 0.10" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.13" />
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0" />
      <mass value="1.5" />
      <inertia ixx="0.012" ixy="0" ixz="0"
               iyy="0.012" iyz="0"
               izz="0.010" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Perception Sensors: Planar LiDAR and RGB-D Stereo Camera                -->
  <!-- ======================================================================== -->
  <!-- LiDAR: Mounted at the top crown (HEAD_LIDAR in Blender, Z=1.175m) -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.10" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="head_link" />
    <child link="lidar_link" />
    <origin xyz="0.0 0.0 0.270" rpy="0 0 0" />
  </joint>

  <!-- Camera: Mounted at front sensor bar on the face (Z=1.02m, X=0.112m) -->
  <link name="camera_link">
    <inertial>
      <mass value="0.08" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="head_link" />
    <child link="camera_link" />
    <origin xyz="0.112 0.0 0.115" rpy="0 0 0" />
  </joint>

  <!-- Camera Optical Frame (ROS Standard: Z forward, X right, Y down) -->
  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Left Arm Pod (Natural Posture / Tucked Pod)                             -->
  <!-- ======================================================================== -->
  <link name="left_arm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/left_arm_visual.obj" />
      </geometry>
    </visual>
    <collision name="left_arm_collision">
      <origin xyz="0.03 0.04 -0.16" rpy="0 0 0" />
      <geometry><box size="0.10 0.09 0.36" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 0.04 -0.16" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005" />
    </inertial>
  </link>

  <joint name="left_arm_joint" type="fixed">
    <parent link="torso_link" />
    <child link="left_arm_link" />
    <origin xyz="0.0 ${shoulder_y} ${shoulder_z}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Right Arm: Articulated 7-DOF Manipulator & Hand Gripper                 -->
  <!-- ======================================================================== -->
  <!-- Joint 1: Shoulder Yaw (Z) -->
  <link name="right_shoulder_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.040" /></geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.038" /></geometry>
    </collision>
    <inertial><mass value="0.2" /><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" /></inertial>
  </link>

  <joint name="right_shoulder_yaw_joint" type="revolute">
    <parent link="torso_link" />
    <child link="right_shoulder_yaw_link" />
    <origin xyz="0.0 ${-shoulder_y} ${shoulder_z}" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="50.0" velocity="3.0" />
    <dynamics damping="1.5" friction="0.05" />
  </joint>

  <!-- Joint 2: Shoulder Pitch (Y) -->
  <link name="right_shoulder_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.038" /></geometry>
      <material name="accent_orange" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.036" /></geometry>
    </collision>
    <inertial><mass value="0.2" /><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" /></inertial>
  </link>

  <joint name="right_shoulder_pitch_joint" type="revolute">
    <parent link="right_shoulder_yaw_link" />
    <child link="right_shoulder_pitch_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="2.0944" effort="50.0" velocity="3.0" />
    <dynamics damping="1.5" friction="0.05" />
  </joint>

  <!-- Joint 3: Shoulder Roll (X) / Upper Arm Link -->
  <link name="right_upper_arm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/right_upper_arm_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.075" rpy="0 0 0" />
      <geometry><cylinder radius="0.035" length="0.15" /></geometry>
    </collision>
    <inertial><mass value="0.5" /><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005" /></inertial>
  </link>

  <joint name="right_shoulder_roll_joint" type="revolute">
    <parent link="right_shoulder_pitch_link" />
    <child link="right_upper_arm_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="40.0" velocity="3.0" />
    <dynamics damping="1.0" friction="0.05" />
  </joint>

  <!-- Joint 4: Elbow Pitch (Y) / Forearm Link -->
  <link name="right_forearm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/right_forearm_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 -0.02 -0.075" rpy="0 0 0" />
      <geometry><cylinder radius="0.030" length="0.15" /></geometry>
    </collision>
    <inertial><mass value="0.4" /><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0003" /></inertial>
  </link>

  <joint name="right_elbow_pitch_joint" type="revolute">
    <parent link="right_upper_arm_link" />
    <child link="right_forearm_link" />
    <origin xyz="0.0 -0.035 -0.150" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0944" upper="0.0" effort="30.0" velocity="3.0" />
    <dynamics damping="1.0" friction="0.05" />
  </joint>

  <!-- Joint 5: Wrist Pitch (Y) -->
  <link name="right_wrist_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.025" /></geometry>
      <material name="accent_orange" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><sphere radius="0.024" /></geometry>
    </collision>
    <inertial><mass value="0.1" /><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" /></inertial>
  </link>

  <joint name="right_wrist_pitch_joint" type="revolute">
    <parent link="right_forearm_link" />
    <child link="right_wrist_pitch_link" />
    <origin xyz="0.0 -0.026 -0.150" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="15.0" velocity="4.0" />
    <dynamics damping="0.5" friction="0.02" />
  </joint>

  <!-- Joint 6: Wrist Yaw (Z) -->
  <link name="right_wrist_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.020" length="0.015" /></geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.020" length="0.015" /></geometry>
    </collision>
    <inertial><mass value="0.08" /><inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005" /></inertial>
  </link>

  <joint name="right_wrist_yaw_joint" type="revolute">
    <parent link="right_wrist_pitch_link" />
    <child link="right_wrist_yaw_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="15.0" velocity="4.0" />
    <dynamics damping="0.5" friction="0.02" />
  </joint>

  <!-- Joint 7: Wrist Roll (X) / Palm Link -->
  <link name="right_palm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/right_palm_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.03" rpy="0 0 0" />
      <geometry><box size="0.05 0.06 0.06" /></geometry>
    </collision>
    <inertial><mass value="0.15" /><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" /></inertial>
  </link>

  <joint name="right_wrist_roll_joint" type="revolute">
    <parent link="right_wrist_yaw_link" />
    <child link="right_palm_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1415" upper="3.1415" effort="10.0" velocity="4.0" />
    <dynamics damping="0.3" friction="0.02" />
  </joint>

  <!-- Gripper Fingers -->
  <link name="finger_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/right_finger_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry><box size="0.02 0.05 0.04" /></geometry>
    </collision>
    <inertial><mass value="0.05" /><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002" /></inertial>
  </link>

  <joint name="finger_left_joint" type="prismatic">
    <parent link="right_palm_link" />
    <child link="finger_left_link" />
    <origin xyz="0.0 -0.002 -0.080" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0.0" upper="0.035" effort="20.0" velocity="0.1" />
    <dynamics damping="1.0" friction="0.05" />
  </joint>

  <link name="finger_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://${pkg}/meshes/right_thumb_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry><box size="0.02 0.02 0.04" /></geometry>
    </collision>
    <inertial><mass value="0.03" /><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" /></inertial>
  </link>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="right_palm_link" />
    <child link="finger_right_link" />
    <origin xyz="0.0 -0.037 -0.055" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0.0" upper="0.035" effort="20.0" velocity="0.1" />
    <dynamics damping="1.0" friction="0.05" />
  </joint>

</robot>
