<?xml version="1.0"?>
<robot name="gracemo_vira" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-files -->
  <xacro:include filename="$(find gracemo_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find gracemo_description)/urdf/gazebo_plugins.xacro" />

  <!-- Dimensions & Constants -->
  <xacro:property name="wheel_radius" value="0.065" />
  <xacro:property name="wheel_width" value="0.035" />
  <xacro:property name="wheelbase" value="0.32" />
  <xacro:property name="chassis_radius" value="0.20" />
  <xacro:property name="chassis_height" value="0.14" />
  <xacro:property name="torso_height" value="0.40" />
  <xacro:property name="torso_width" value="0.22" />
  <xacro:property name="torso_depth" value="0.18" />

  <!-- ======================================================================== -->
  <!-- Base Footprint (Ground Projection)                                       -->
  <!-- ======================================================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Base Link (Sleek Cylindrical Mobile Chassis)                             -->
  <!-- ======================================================================== -->
  <link name="base_link">
    <!-- Main Cylindrical Chassis Shell -->
    <visual>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <!-- Lower Protective Skirt Ring -->
    <visual>
      <origin xyz="0 0 ${chassis_height * 0.2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius + 0.005}" length="${chassis_height * 0.35}" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <!-- Top Deck Accent Plate -->
    <visual>
      <origin xyz="0 0 ${chassis_height + 0.005}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius * 0.9}" length="0.01" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <mass value="6.5" />
      <inertia ixx="0.07" ixy="0.0" ixz="0.0" iyy="0.07" iyz="0.0" izz="0.12" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Drive Wheels (Left & Right - Recessed in Wheel Wells)                     -->
  <!-- ======================================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <!-- Rubber Tire -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="rubber_black" />
      </visual>
      <!-- Metallic Silver Rim Hub -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius * 0.6}" length="${wheel_width + 0.002}" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.6" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0015" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="150.0" velocity="20.0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheelbase/2.0}" />
  <xacro:wheel prefix="right" y_offset="${-wheelbase/2.0}" />

  <!-- ======================================================================== -->
  <!-- Support Casters (Front & Rear Spheres)                                   -->
  <!-- ======================================================================== -->
  <xacro:macro name="caster" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="0.032" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.030" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.10" />
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_offset} 0 ${-wheel_radius + 0.032}" rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>100000.0</kp>
      <kd>10.0</kd>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="${chassis_radius - 0.06}" />
  <xacro:caster prefix="rear" x_offset="${-chassis_radius + 0.06}" />

  <!-- ======================================================================== -->
  <!-- Humanoid Torso (Center Column & Chest Status Display)                     -->
  <!-- ======================================================================== -->
  <link name="torso_link">
    <!-- Torso Column Body -->
    <visual>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${torso_depth} ${torso_width} ${torso_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <!-- Chest Glass Status Screen -->
    <visual>
      <origin xyz="${torso_depth/2.0 + 0.004} 0 ${torso_height * 0.6}" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.14 0.12" />
      </geometry>
      <material name="camera_lens_black" />
    </visual>
    <collision>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${torso_depth} ${torso_width} ${torso_height}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <mass value="3.5" />
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link" />
    <child link="torso_link" />
    <origin xyz="-0.02 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- 2D LiDAR (Mounted on Front Deck Platform)                                -->
  <!-- ======================================================================== -->
  <link name="lidar_link">
    <!-- LiDAR Base Turret -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.03" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <!-- LiDAR Spinning Ring -->
    <visual>
      <origin xyz="0 0 0.032" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.015" />
      </geometry>
      <material name="lidar_orange" />
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002" />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.13 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Humanoid Head & Visor                                                    -->
  <!-- ======================================================================== -->
  <link name="head_link">
    <!-- Neck Joint -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.04" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <!-- Rounded Head Shell -->
    <visual>
      <origin xyz="0.01 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.14 0.16 0.11" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <!-- Dark Glass Face Visor -->
    <visual>
      <origin xyz="0.081 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.13 0.07" />
      </geometry>
      <material name="camera_lens_black" />
    </visual>
    <collision>
      <origin xyz="0.01 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.14 0.16 0.11" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.01 0 0.08" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso_link" />
    <child link="head_link" />
    <origin xyz="0 0 ${torso_height}" rpy="0 0 0" />
  </joint>

  <!-- Camera Link (Front Centered Optical Eye) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.012" length="0.01" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="head_link" />
    <child link="camera_link" />
    <origin xyz="0.085 0 0.09" rpy="0 0 0" />
  </joint>

  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Left & Right Manipulation Arm Pods (Sleek Anatomical Integration)        -->
  <!-- ======================================================================== -->
  <xacro:macro name="arm" params="prefix y_offset">
    <link name="${prefix}_arm_link">
      <!-- Upper Arm Column -->
      <visual>
        <origin xyz="0 0 -0.09" rpy="0 0 0" />
        <geometry>
          <box size="0.045 0.035 0.18" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <!-- Forearm Section -->
      <visual>
        <origin xyz="0.025 0 -0.21" rpy="0 0.2 0" />
        <geometry>
          <box size="0.04 0.03 0.13" />
        </geometry>
        <material name="dark_grey" />
      </visual>
      <!-- Gripper Hand Accent -->
      <visual>
        <origin xyz="0.055 0 -0.27" rpy="0 0.2 0" />
        <geometry>
          <box size="0.03 0.025 0.02" />
        </geometry>
        <material name="lidar_orange" />
      </visual>
      <collision>
        <origin xyz="0.02 0 -0.15" rpy="0 0 0" />
        <geometry>
          <box size="0.06 0.045 0.30" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.02 0 -0.15" rpy="0 0 0" />
        <mass value="0.7" />
        <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="${prefix}_arm_joint" type="fixed">
      <parent link="torso_link" />
      <child link="${prefix}_arm_link" />
      <origin xyz="0.0 ${y_offset} ${torso_height - 0.04}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:arm prefix="left" y_offset="${torso_width/2.0 + 0.022}" />
  <xacro:arm prefix="right" y_offset="${-torso_width/2.0 - 0.022}" />

  <!-- ======================================================================== -->
  <!-- IMU Link                                                                 -->
  <!-- ======================================================================== -->
  <link name="imu_link" />

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.08" rpy="0 0 0" />
  </joint>

</robot>
