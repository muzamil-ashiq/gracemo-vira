<?xml version="1.0"?>
<robot name="gracemo_vira" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-files -->
  <xacro:include filename="$(find gracemo_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find gracemo_description)/urdf/gazebo_plugins.xacro" />

  <!-- Dimensions & Constants -->
  <xacro:property name="wheel_radius" value="0.065" />
  <xacro:property name="wheel_width" value="0.035" />
  <xacro:property name="wheelbase" value="0.32" />
  <xacro:property name="chassis_length" value="0.38" />
  <xacro:property name="chassis_width" value="0.26" />
  <xacro:property name="chassis_height" value="0.12" />
  <xacro:property name="torso_height" value="0.40" />
  <xacro:property name="torso_width" value="0.22" />
  <xacro:property name="torso_depth" value="0.18" />

  <!-- ======================================================================== -->
  <!-- Base Footprint (Ground Projection)                                       -->
  <!-- ======================================================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Base Link (Chassis Body)                                                 -->
  <!-- ======================================================================== -->
  <link name="base_link">
    <!-- Main Chassis Body -->
    <visual>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
    <!-- Top accent plate -->
    <visual>
      <origin xyz="0 0 ${chassis_height + 0.005}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length - 0.04} ${chassis_width - 0.04} 0.01" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <inertial>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <mass value="6.0" />
      <inertia ixx="0.06" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.10" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Drive Wheels (Left & Right)                                              -->
  <!-- ======================================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="rubber_black" />
      </visual>
      <!-- Wheel rim accent -->
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius * 0.6}" length="${wheel_width + 0.002}" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.6" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0015" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="150.0" velocity="20.0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheelbase/2.0}" />
  <xacro:wheel prefix="right" y_offset="${-wheelbase/2.0}" />

  <!-- ======================================================================== -->
  <!-- Support Casters (Front & Rear)                                           -->
  <!-- ======================================================================== -->
  <xacro:macro name="caster" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="0.0335" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.0335" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15" />
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_offset} 0 ${-wheel_radius + 0.0335}" rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="${chassis_length/2.0 - 0.05}" />
  <xacro:caster prefix="rear" x_offset="${-chassis_length/2.0 + 0.05}" />

  <!-- ======================================================================== -->
  <!-- Upper Torso & Humanoid Body                                              -->
  <!-- ======================================================================== -->
  <link name="torso_link">
    <!-- Main Chest / Torso Body -->
    <visual>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${torso_depth} ${torso_width} ${torso_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${torso_depth} ${torso_width} ${torso_height}" />
      </geometry>
    </collision>
    <!-- Chest Screen / Accent Panel -->
    <visual>
      <origin xyz="${torso_depth/2.0 + 0.005} 0 ${torso_height * 0.6}" rpy="0 0 0" />
      <geometry>
        <box size="0.01 0.14 0.12" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <inertial>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <mass value="3.5" />
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link" />
    <child link="torso_link" />
    <origin xyz="-0.02 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- 2D LiDAR (Chest Platform Front)                                          -->
  <!-- ======================================================================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.035" />
      </geometry>
      <material name="lidar_orange" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.035" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002" />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.14 0 ${chassis_height + 0.02}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Humanoid Head & Visor                                                    -->
  <!-- ======================================================================== -->
  <link name="head_link">
    <!-- Neck -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.04" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <!-- Head Unit -->
    <visual>
      <origin xyz="0.01 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.13 0.16 0.11" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0.01 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.13 0.16 0.11" />
      </geometry>
    </collision>
    <!-- Dark Visor / Face Display -->
    <visual>
      <origin xyz="0.076 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.13 0.07" />
      </geometry>
      <material name="camera_lens_black" />
    </visual>
    <inertial>
      <origin xyz="0.01 0 0.08" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso_link" />
    <child link="head_link" />
    <origin xyz="0 0 ${torso_height}" rpy="0 0 0" />
  </joint>

  <!-- Camera Link (Inside Head Visor) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.012" length="0.01" />
      </geometry>
      <material name="dark_grey" />
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="head_link" />
    <child link="camera_link" />
    <origin xyz="0.08 0 0.09" rpy="0 0 0" />
  </joint>

  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Humanoid Arms (Left & Right - Solid Anatomical Structure)                -->
  <!-- ======================================================================== -->
  <xacro:macro name="humanoid_arm" params="prefix y_offset reflect">
    <link name="${prefix}_arm_link">
      <!-- Shoulder Joint sphere -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><sphere radius="0.035" /></geometry>
        <material name="dark_grey" />
      </visual>
      <!-- Upper Arm (pointing down along torso) -->
      <visual>
        <origin xyz="0 0 -0.09" rpy="0 0 0" />
        <geometry><cylinder radius="0.022" length="0.16" /></geometry>
        <material name="metallic_silver" />
      </visual>
      <!-- Elbow Joint sphere -->
      <visual>
        <origin xyz="0 0 -0.17" rpy="0 0 0" />
        <geometry><sphere radius="0.025" /></geometry>
        <material name="dark_grey" />
      </visual>
      <!-- Forearm (angled slightly forward) -->
      <visual>
        <origin xyz="0.04 0 -0.23" rpy="0 0.4 0" />
        <geometry><cylinder radius="0.020" length="0.14" /></geometry>
        <material name="metallic_silver" />
      </visual>
      <!-- Hand / Gripper unit -->
      <visual>
        <origin xyz="0.09 0 -0.28" rpy="0 0.4 0" />
        <geometry><box size="0.04 0.035 0.03" /></geometry>
        <material name="dark_grey" />
      </visual>
      <!-- Pincer fingers -->
      <visual>
        <origin xyz="0.115 0.01 -0.29" rpy="0 0.4 0" />
        <geometry><box size="0.025 0.006 0.012" /></geometry>
        <material name="lidar_orange" />
      </visual>
      <visual>
        <origin xyz="0.115 -0.01 -0.29" rpy="0 0.4 0" />
        <geometry><box size="0.025 0.006 0.012" /></geometry>
        <material name="lidar_orange" />
      </visual>

      <collision>
        <origin xyz="0.03 0 -0.15" rpy="0 0 0" />
        <geometry><box size="0.08 0.06 0.32" /></geometry>
      </collision>
      <inertial>
        <origin xyz="0.03 0 -0.15" rpy="0 0 0" />
        <mass value="0.8" />
        <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="${prefix}_arm_joint" type="fixed">
      <parent link="torso_link" />
      <child link="${prefix}_arm_link" />
      <origin xyz="0.0 ${y_offset} ${torso_height - 0.04}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:humanoid_arm prefix="left" y_offset="${torso_width/2.0 + 0.035}" reflect="1" />
  <xacro:humanoid_arm prefix="right" y_offset="${-torso_width/2.0 - 0.035}" reflect="-1" />

  <!-- ======================================================================== -->
  <!-- IMU Link                                                                 -->
  <!-- ======================================================================== -->
  <link name="imu_link" />

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.08" rpy="0 0 0" />
  </joint>

</robot>
