<?xml version="1.0"?>
<robot name="gracemo_vira" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-files -->
  <xacro:include filename="$(find gracemo_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find gracemo_description)/urdf/gazebo_plugins.xacro" />

  <!-- Dimensions & Constants -->
  <xacro:property name="wheel_radius" value="0.065" />
  <xacro:property name="wheel_width" value="0.035" />
  <xacro:property name="wheelbase" value="0.33" />
  <xacro:property name="chassis_l" value="0.40" />
  <xacro:property name="chassis_w" value="0.28" />
  <xacro:property name="chassis_h" value="0.14" />
  <xacro:property name="torso_l" value="0.20" />
  <xacro:property name="torso_w" value="0.22" />
  <xacro:property name="torso_h" value="0.38" />

  <!-- ======================================================================== -->
  <!-- Base Footprint (Ground Projection)                                       -->
  <!-- ======================================================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Base Link (Chassis Body)                                                 -->
  <!-- ======================================================================== -->
  <link name="base_link">
    <!-- Main Chassis Box -->
    <visual>
      <origin xyz="0 0 ${chassis_h/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_h/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}" />
      </geometry>
    </collision>
    <!-- Bumper Trim Front -->
    <visual>
      <origin xyz="${chassis_l/2.0} 0 ${chassis_h/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="0.02 ${chassis_w + 0.01} ${chassis_h - 0.02}" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <inertial>
      <origin xyz="0 0 ${chassis_h/2.0}" rpy="0 0 0" />
      <mass value="6.0" />
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.09" iyz="0.0" izz="0.11" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Drive Wheels (Left & Right)                                              -->
  <!-- ======================================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="rubber_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.6" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0015" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="150.0" velocity="20.0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheelbase/2.0}" />
  <xacro:wheel prefix="right" y_offset="${-wheelbase/2.0}" />

  <!-- ======================================================================== -->
  <!-- Support Casters (Front & Rear)                                           -->
  <!-- ======================================================================== -->
  <xacro:macro name="caster" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="0.0335" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.0335" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.15" />
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_offset} 0 ${-wheel_radius + 0.0335}" rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="${chassis_l/2.0 - 0.05}" />
  <xacro:caster prefix="rear" x_offset="${-chassis_l/2.0 + 0.05}" />

  <!-- ======================================================================== -->
  <!-- Torso & Humanoid Body Column                                             -->
  <!-- ======================================================================== -->
  <link name="torso_link">
    <!-- Torso Column -->
    <visual>
      <origin xyz="0 0 ${torso_h/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${torso_l} ${torso_w} ${torso_h}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${torso_h/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${torso_l} ${torso_w} ${torso_h}" />
      </geometry>
    </collision>
    <!-- Chest Screen Display -->
    <visual>
      <origin xyz="${torso_l/2.0 + 0.005} 0 ${torso_h * 0.6}" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.14 0.12" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <inertial>
      <origin xyz="0 0 ${torso_h/2.0}" rpy="0 0 0" />
      <mass value="3.5" />
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link" />
    <child link="torso_link" />
    <origin xyz="-0.02 0 ${chassis_h}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- 2D LiDAR (Front Chest Deck)                                              -->
  <!-- ======================================================================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.04" />
      </geometry>
      <material name="lidar_orange" />
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002" />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="${chassis_l/2.0 - 0.06} 0 ${chassis_h}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Head & Camera Visor                                                      -->
  <!-- ======================================================================== -->
  <link name="head_link">
    <!-- Neck Collar -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.04" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <!-- Head Unit -->
    <visual>
      <origin xyz="0.01 0 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.14 0.16 0.12" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0.01 0 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.14 0.16 0.12" />
      </geometry>
    </collision>
    <!-- Dark Glass Face Visor -->
    <visual>
      <origin xyz="0.082 0 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.13 0.07" />
      </geometry>
      <material name="camera_lens_black" />
    </visual>
    <inertial>
      <origin xyz="0.01 0 0.09" rpy="0 0 0" />
      <mass value="0.8" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso_link" />
    <child link="head_link" />
    <origin xyz="0 0 ${torso_h}" rpy="0 0 0" />
  </joint>

  <!-- Camera Link (Front Eye) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.012" length="0.01" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="head_link" />
    <child link="camera_link" />
    <origin xyz="0.086 0 0.10" rpy="0 0 0" />
  </joint>

  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Left & Right Humanoid Arms (Clean Integrated Design)                     -->
  <!-- ======================================================================== -->
  <xacro:macro name="arm" params="prefix y_offset">
    <link name="${prefix}_arm_link">
      <!-- Upper Arm -->
      <visual>
        <origin xyz="0 0 -0.09" rpy="0 0 0" />
        <geometry>
          <box size="0.05 0.04 0.18" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <!-- Forearm & Gripper -->
      <visual>
        <origin xyz="0.03 0 -0.22" rpy="0 0.25 0" />
        <geometry>
          <box size="0.045 0.035 0.14" />
        </geometry>
        <material name="dark_grey" />
      </visual>
      <!-- Gripper Hand Accent -->
      <visual>
        <origin xyz="0.065 0 -0.28" rpy="0 0.25 0" />
        <geometry>
          <box size="0.03 0.03 0.02" />
        </geometry>
        <material name="lidar_orange" />
      </visual>
      <collision>
        <origin xyz="0.02 0 -0.16" rpy="0 0 0" />
        <geometry>
          <box size="0.07 0.05 0.32" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.02 0 -0.16" rpy="0 0 0" />
        <mass value="0.7" />
        <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="${prefix}_arm_joint" type="fixed">
      <parent link="torso_link" />
      <child link="${prefix}_arm_link" />
      <origin xyz="0.0 ${y_offset} ${torso_h - 0.04}" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:arm prefix="left" y_offset="${torso_w/2.0 + 0.025}" />
  <xacro:arm prefix="right" y_offset="${-torso_w/2.0 - 0.025}" />

  <!-- ======================================================================== -->
  <!-- IMU Link                                                                 -->
  <!-- ======================================================================== -->
  <link name="imu_link" />

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.08" rpy="0 0 0" />
  </joint>

</robot>
