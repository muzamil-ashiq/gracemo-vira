<?xml version="1.0"?>
<robot name="gracemo_vira" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-files -->
  <xacro:include filename="$(find gracemo_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find gracemo_description)/urdf/gazebo_plugins.xacro" />

  <!-- Dimensions & Constants -->
  <xacro:property name="wheel_radius" value="0.065" />
  <xacro:property name="wheel_width" value="0.030" />
  <xacro:property name="wheelbase" value="0.34" />
  <xacro:property name="chassis_radius" value="0.19" />
  <xacro:property name="chassis_height" value="0.14" />
  <xacro:property name="torso_height" value="0.40" />
  <xacro:property name="torso_width" value="0.20" />
  <xacro:property name="torso_depth" value="0.16" />

  <!-- Base Footprint (Ground Projection) -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Base Link (Sleek Mobile Chassis with Non-Overlapping Collision)          -->
  <!-- ======================================================================== -->
  <link name="base_link">
    <!-- Visual Shell -->
    <visual>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius}" length="${chassis_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <!-- Lower Protective Skirt -->
    <visual>
      <origin xyz="0 0 ${chassis_height * 0.2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius + 0.005}" length="${chassis_height * 0.35}" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <!-- Top Deck Plate -->
    <visual>
      <origin xyz="0 0 ${chassis_height + 0.005}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${chassis_radius * 0.9}" length="0.01" />
      </geometry>
      <material name="dark_grey" />
    </visual>

    <collision>
      <origin xyz="0 0 ${chassis_height/2.0 + 0.01}" rpy="0 0 0" />
      <geometry>
        <box size="0.24 0.20 ${chassis_height}" />
      </geometry>
    </collision>

    <!-- Heavy low base mass to keep wheels firmly planted with high traction -->
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <mass value="8.0" />
      <inertia ixx="0.04" ixy="0.0" ixz="0.0" iyy="0.04" iyz="0.0" izz="0.06" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- 360° Tactile Bumper Ring (Physical Contact Sensor & RGB Halo)            -->
  <!-- ======================================================================== -->
  <link name="bumper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.205" length="0.04" />
      </geometry>
      <material name="cyan_glow" />
    </visual>
    <collision name="bumper_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.205" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="bumper_joint" type="fixed">
    <parent link="base_link" />
    <child link="bumper_link" />
    <origin xyz="0 0 0.04" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Corner ToF / Ultrasonic Proximity Sensor Mounts                          -->
  <!-- ======================================================================== -->
  <link name="tof_front_left_link">
    <inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="tof_front_left_joint" type="fixed">
    <parent link="base_link" />
    <child link="tof_front_left_link" />
    <origin xyz="0.16 0.12 0.08" rpy="0 0 0.7854" />
  </joint>

  <link name="tof_front_right_link">
    <inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="tof_front_right_joint" type="fixed">
    <parent link="base_link" />
    <child link="tof_front_right_link" />
    <origin xyz="0.16 -0.12 0.08" rpy="0 0 -0.7854" />
  </joint>

  <link name="tof_rear_link">
    <inertial><mass value="0.01"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="tof_rear_joint" type="fixed">
    <parent link="base_link" />
    <child link="tof_rear_link" />
    <origin xyz="-0.18 0 0.08" rpy="0 0 3.14159" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Drive Wheels (High Grip & Smooth Rolling)                                -->
  <!-- ======================================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="rubber_black" />
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius * 0.6}" length="${wheel_width + 0.002}" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.8" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="150.0" velocity="20.0" />
      <dynamics damping="1.5" friction="1.5" />
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheelbase/2.0}" />
  <xacro:wheel prefix="right" y_offset="${-wheelbase/2.0}" />

  <!-- ======================================================================== -->
  <!-- Support Casters (Exact ground tangent frictionless gliders)              -->
  <!-- ======================================================================== -->
  <xacro:macro name="caster" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <!-- Rolling Caster Ball -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="0.025" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <!-- Caster Mounting Housing / Bracket (solidly connects ball to chassis underside) -->
      <visual>
        <origin xyz="0 0 0.022" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.022" length="0.035" />
        </geometry>
        <material name="dark_grey" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.025" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05" />
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_offset} 0 ${-wheel_radius + 0.025}" rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>10.0</kd>
      <minDepth>0.0001</minDepth>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="0.14" />
  <xacro:caster prefix="rear" x_offset="-0.14" />

  <!-- ======================================================================== -->
  <!-- Humanoid Torso (Visual Only — Collision handled by unified base)         -->
  <!-- ======================================================================== -->
  <link name="torso_link">
    <visual>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${torso_depth} ${torso_width} ${torso_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <visual>
      <origin xyz="${torso_depth/2.0 + 0.004} 0 ${torso_height * 0.6}" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.13 0.11" />
      </geometry>
      <material name="camera_lens_black" />
    </visual>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link" />
    <child link="torso_link" />
    <origin xyz="-0.02 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- 2D LiDAR Sensor                                                          -->
  <!-- ======================================================================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.03" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <visual>
      <origin xyz="0 0 0.032" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.015" />
      </geometry>
      <material name="lidar_orange" />
    </visual>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.11 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Humanoid Head & Camera                                                   -->
  <!-- ======================================================================== -->
  <link name="head_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.035" length="0.04" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <visual>
      <origin xyz="0.01 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.14 0.16 0.11" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <visual>
      <origin xyz="0.081 0 0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.006 0.13 0.07" />
      </geometry>
      <material name="camera_lens_black" />
    </visual>
    <inertial>
      <origin xyz="0.01 0 0.08" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <parent link="torso_link" />
    <child link="head_link" />
    <origin xyz="0 0 ${torso_height}" rpy="0 0 0" />
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.012" length="0.01" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="head_link" />
    <child link="camera_link" />
    <origin xyz="0.085 0 0.09" rpy="0 0 0" />
  </joint>

  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Manipulation Arm Pods (Visual Only)                                      -->
  <!-- ======================================================================== -->
  <!-- Left Arm Pod (Visual Only) -->
  <link name="left_arm_link">
    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 0" />
      <geometry>
        <box size="0.045 0.035 0.18" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <inertial>
      <origin xyz="0 0 -0.09" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="left_arm_joint" type="fixed">
    <parent link="torso_link" />
    <child link="left_arm_link" />
    <origin xyz="0.0 ${torso_width/2.0 + 0.022} ${torso_height - 0.04}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- 6-DOF Articulated Right Manipulator Arm (Milestones M2 / M3)             -->
  <!-- ======================================================================== -->
  <!-- Joint 1: Shoulder Yaw (Z) — Spherical Ball-and-Socket Outer Cup -->
  <link name="right_shoulder_yaw_link">
    <!-- Outer Socket Cup (Matte Dark Titanium) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.040" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <!-- Torso Mounting Collar -->
    <visual>
      <origin xyz="0 0.015 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="0.034" length="0.030" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <inertial>
      <mass value="0.15" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="right_shoulder_yaw_joint" type="revolute">
    <parent link="torso_link" />
    <child link="right_shoulder_yaw_link" />
    <origin xyz="0.0 ${-torso_width/2.0 - 0.022} ${torso_height - 0.04}" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="50.0" velocity="1.5" />
    <dynamics damping="0.2" friction="0.05" />
  </joint>

  <!-- Joint 2: Shoulder Pitch (Y) — Inner Ball Core & Gimbal Pivot -->
  <link name="right_shoulder_pitch_link">
    <!-- Rotating Spherical Ball Core (Metallic Silver) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.035" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <!-- Lateral Pivot Bearing Caps -->
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="0.026" length="0.046" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <inertial>
      <mass value="0.15" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="right_shoulder_pitch_joint" type="revolute">
    <parent link="right_shoulder_yaw_link" />
    <child link="right_shoulder_pitch_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="2.0944" effort="50.0" velocity="1.5" />
    <dynamics damping="0.2" friction="0.05" />
  </joint>

  <!-- Joint 3: Shoulder Roll (X) + Upper Arm Link (L1 = 0.22m along +X) with Elbow Knuckle Clevis -->
  <link name="right_upper_arm_link">
    <!-- Proximal Collar -->
    <visual>
      <origin xyz="0.015 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.027" length="0.030" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <!-- Upper Arm Cylindrical Bone (Chassis Blue) -->
    <visual>
      <origin xyz="0.11 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.022" length="0.17" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <!-- Distal Elbow Knuckle Hinge Housing (Matte Dark Titanium) -->
    <visual>
      <origin xyz="0.22 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="0.028" length="0.046" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <visual>
      <origin xyz="0.22 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.028" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <collision>
      <origin xyz="0.11 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.024" length="0.22" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.11 0 0" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="right_shoulder_roll_joint" type="revolute">
    <parent link="right_shoulder_pitch_link" />
    <child link="right_upper_arm_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.7854" upper="1.5708" effort="50.0" velocity="1.5" />
    <dynamics damping="0.2" friction="0.05" />
  </joint>

  <!-- Joint 4: Elbow Pitch (Y) + Forearm Link (L2 = 0.22m along +X) with Knuckle Bearing -->
  <link name="right_forearm_link">
    <!-- Elbow Inner Hinge Bearing (Metallic Silver) -->
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="0.024" length="0.038" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.024" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <!-- Forearm Bone (Metallic Silver) -->
    <visual>
      <origin xyz="0.11 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.019" length="0.17" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <!-- Distal Wrist Knuckle Cup (Matte Dark Titanium) -->
    <visual>
      <origin xyz="0.22 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.024" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <collision>
      <origin xyz="0.11 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.020" length="0.22" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.11 0 0" rpy="0 0 0" />
      <mass value="0.25" />
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0010" iyz="0.0" izz="0.0010" />
    </inertial>
  </link>

  <joint name="right_elbow_pitch_joint" type="revolute">
    <parent link="right_upper_arm_link" />
    <child link="right_forearm_link" />
    <origin xyz="0.22 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.3562" upper="0.0" effort="50.0" velocity="1.5" />
    <dynamics damping="0.2" friction="0.05" />
  </joint>

  <!-- Joint 5: Wrist Pitch Joint (Y) connecting Forearm to Wrist Pitch Gimbal Link -->
  <link name="right_wrist_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="0.020" length="0.025" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.05" />
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002" />
    </inertial>
  </link>

  <joint name="right_wrist_pitch_joint" type="revolute">
    <parent link="right_forearm_link" />
    <child link="right_wrist_pitch_link" />
    <origin xyz="0.22 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="30.0" velocity="2.0" />
    <dynamics damping="0.1" friction="0.02" />
  </joint>

  <!-- Joint 6: Wrist Yaw Joint (Z) providing lateral/sideways wrist deviation -->
  <link name="right_wrist_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.018" length="0.020" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.04" />
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
  </link>

  <joint name="right_wrist_yaw_joint" type="revolute">
    <parent link="right_wrist_pitch_link" />
    <child link="right_wrist_yaw_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5708" upper="1.5708" effort="25.0" velocity="2.5" />
    <dynamics damping="0.1" friction="0.02" />
  </joint>

  <!-- Joint 7: Wrist Roll Joint (X) connecting Wrist Yaw Link to Palm -->
  <joint name="right_wrist_roll_joint" type="revolute">
    <parent link="right_wrist_yaw_link" />
    <child link="right_palm_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1415" upper="3.1415" effort="25.0" velocity="2.5" />
    <dynamics damping="0.1" friction="0.02" />
  </joint>

  <!-- Hand Subsystem Palm Link (Compact 88mm Franka/Robotiq-style housing with recessed U-channel) -->
  <link name="right_palm_link">
    <!-- Main Back Housing (Matte Dark Titanium) -->
    <visual>
      <origin xyz="0.010 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.020 0.088 0.034" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <!-- Left Actuator Stanchion -->
    <visual>
      <origin xyz="0.022 0.034 0" rpy="0 0 0" />
      <geometry>
        <box size="0.024 0.020 0.030" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <!-- Right Actuator Stanchion -->
    <visual>
      <origin xyz="0.022 -0.034 0" rpy="0 0 0" />
      <geometry>
        <box size="0.024 0.020 0.030" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <!-- Metallic Silver Guide Rail Trim -->
    <visual>
      <origin xyz="0.020 0 0.015" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.082 0.003" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <visual>
      <origin xyz="0.020 0 -0.015" rpy="0 0 0" />
      <geometry>
        <box size="0.016 0.082 0.003" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <!-- Non-colliding recessed palm collision: only back plate and side stanchions, leaving center U-channel clear -->
    <collision name="right_palm_collision">
      <origin xyz="0.010 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.020 0.088 0.034" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.012 0 0" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia ixx="0.00008" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00008" />
    </inertial>
  </link>

  <!-- Left Gripper Finger (mounted at outer edge +50mm, travels inward 45mm, tapered with orange silicone pad) -->
  <link name="finger_left_link">
    <!-- Structural Finger Body (Matte Dark Titanium) -->
    <visual>
      <origin xyz="0.035 0.005 0" rpy="0 0 0" />
      <geometry>
        <box size="0.070 0.010 0.026" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <!-- Tapered Chamfered Fingertip (Metallic Silver) -->
    <visual>
      <origin xyz="0.068 0.003 0" rpy="0 0 0.25" />
      <geometry>
        <box size="0.012 0.008 0.024" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <!-- High-Friction Orange Silicone Grip Pad (Inner Contact Face) -->
    <visual>
      <origin xyz="0.035 -0.001 0" rpy="0 0 0" />
      <geometry>
        <box size="0.045 0.003 0.022" />
      </geometry>
      <material name="safety_orange" />
    </visual>
    <!-- Collision includes the inner high-friction pad surface -->
    <collision name="finger_left_collision">
      <origin xyz="0.035 0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.070 0.012 0.026" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.035 0.002 0" rpy="0 0 0" />
      <mass value="0.030" />
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
  </link>

  <joint name="finger_left_joint" type="prismatic">
    <parent link="right_palm_link" />
    <child link="finger_left_link" />
    <origin xyz="0.025 0.050 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0.0" upper="0.045" effort="60.0" velocity="0.30" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>

  <!-- Right Gripper Finger (mounted at outer edge -50mm, travels inward 45mm, tapered with orange silicone pad) -->
  <link name="finger_right_link">
    <!-- Structural Finger Body (Matte Dark Titanium) -->
    <visual>
      <origin xyz="0.035 -0.005 0" rpy="0 0 0" />
      <geometry>
        <box size="0.070 0.010 0.026" />
      </geometry>
      <material name="matte_dark_titanium" />
    </visual>
    <!-- Tapered Chamfered Fingertip (Metallic Silver) -->
    <visual>
      <origin xyz="0.068 -0.003 0" rpy="0 0 -0.25" />
      <geometry>
        <box size="0.012 0.008 0.024" />
      </geometry>
      <material name="metallic_silver" />
    </visual>
    <!-- High-Friction Orange Silicone Grip Pad (Inner Contact Face) -->
    <visual>
      <origin xyz="0.035 0.001 0" rpy="0 0 0" />
      <geometry>
        <box size="0.045 0.003 0.022" />
      </geometry>
      <material name="safety_orange" />
    </visual>
    <!-- Collision includes the inner high-friction pad surface -->
    <collision name="finger_right_collision">
      <origin xyz="0.035 -0.002 0" rpy="0 0 0" />
      <geometry>
        <box size="0.070 0.012 0.026" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.035 -0.002 0" rpy="0 0 0" />
      <mass value="0.030" />
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
  </link>

  <joint name="finger_right_joint" type="prismatic">
    <parent link="right_palm_link" />
    <child link="finger_right_link" />
    <origin xyz="0.025 -0.050 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0.0" upper="0.045" effort="60.0" velocity="0.30" />
    <dynamics damping="0.5" friction="0.05" />
  </joint>

  <gazebo reference="finger_left_link">
    <mu1>3.5</mu1>
    <mu2>3.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.002</minDepth>
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="finger_right_link">
    <mu1>3.5</mu1>
    <mu2>3.5</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.002</minDepth>
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- IMU Link -->
  <link name="imu_link" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.08" rpy="0 0 0" />
  </joint>

  <!-- Prevent internal collision explosion -->
  <gazebo>
    <self_collide>false</self_collide>
  </gazebo>

</robot>
