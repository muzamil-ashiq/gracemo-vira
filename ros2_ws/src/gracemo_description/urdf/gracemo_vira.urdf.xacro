<?xml version="1.0"?>
<robot name="gracemo_vira" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-files -->
  <xacro:include filename="$(find gracemo_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find gracemo_description)/urdf/gazebo_plugins.xacro" />

  <!-- Dimensions & Constants -->
  <xacro:property name="wheel_radius" value="0.065" />
  <xacro:property name="wheel_width" value="0.035" />
  <xacro:property name="wheelbase" value="0.32" />
  <xacro:property name="chassis_length" value="0.40" />
  <xacro:property name="chassis_width" value="0.28" />
  <xacro:property name="chassis_height" value="0.18" />
  <xacro:property name="torso_height" value="0.45" />

  <!-- ======================================================================== -->
  <!-- Base Footprint (Ground Projection)                                       -->
  <!-- ======================================================================== -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Base Link (Chassis Body)                                                 -->
  <!-- ======================================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0" />
      <mass value="6.0" />
      <inertia ixx="0.06" ixy="0.0" ixz="0.0" iyy="0.09" iyz="0.0" izz="0.10" />
    </inertial>
  </link>

  <!-- ======================================================================== -->
  <!-- Drive Wheels (Left & Right)                                              -->
  <!-- ======================================================================== -->
  <xacro:macro name="wheel" params="prefix y_offset reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="rubber_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.6" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0015" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit effort="150.0" velocity="20.0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheelbase/2.0}" reflect="1" />
  <xacro:wheel prefix="right" y_offset="${-wheelbase/2.0}" reflect="-1" />

  <!-- ======================================================================== -->
  <!-- Casters (Front & Rear)                                                   -->
  <!-- ======================================================================== -->
  <xacro:macro name="caster" params="prefix x_offset">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="0.0335" />
        </geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.0335" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1" />
        <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x_offset} 0 ${-wheel_radius + 0.0335}" rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <slip1>1.0</slip1>
      <slip2>1.0</slip2>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x_offset="${chassis_length/2.0 - 0.05}" />
  <xacro:caster prefix="rear" x_offset="${-chassis_length/2.0 + 0.05}" />

  <!-- ======================================================================== -->
  <!-- Humanoid Upper Torso & Spine                                             -->
  <!-- ======================================================================== -->
  <link name="torso_link">
    <visual>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.26 ${torso_height}" />
      </geometry>
      <material name="chassis_blue" />
    </visual>
    <collision>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.26 ${torso_height}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${torso_height/2.0}" rpy="0 0 0" />
      <mass value="3.5" />
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.02" />
    </inertial>
  </link>

  <joint name="torso_joint" type="fixed">
    <parent link="base_link" />
    <child link="torso_link" />
    <origin xyz="-0.02 0 ${chassis_height}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- 2D LiDAR Link (Mounted on Lower Chest Platform for 360° Clear Line of Sight)-->
  <!-- ======================================================================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.04" />
      </geometry>
      <material name="lidar_orange" />
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.04" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0002" />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.14 0 ${chassis_height + 0.02}" rpy="0 0 0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Dual Humanoid Manipulation Arms & Hands (Left & Right)                   -->
  <!-- ======================================================================== -->
  <xacro:macro name="humanoid_arm" params="prefix y_offset reflect">
    <!-- Shoulder Pitch -->
    <link name="${prefix}_shoulder_link">
      <visual>
        <geometry><sphere radius="0.04" /></geometry>
        <material name="dark_grey" />
      </visual>
      <inertial><mass value="0.3" /><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" /></inertial>
    </link>

    <joint name="${prefix}_shoulder_pitch_joint" type="revolute">
      <parent link="torso_link" />
      <child link="${prefix}_shoulder_link" />
      <origin xyz="0.0 ${y_offset} ${torso_height - 0.06}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0" />
    </joint>

    <!-- Upper Arm (Shoulder Roll) -->
    <link name="${prefix}_upper_arm_link">
      <visual>
        <origin xyz="0 0 -0.10" rpy="0 0 0" />
        <geometry><cylinder radius="0.025" length="0.20" /></geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.10" rpy="0 0 0" />
        <geometry><cylinder radius="0.025" length="0.20" /></geometry>
      </collision>
      <inertial><origin xyz="0 0 -0.10" /><mass value="0.5" /><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005" /></inertial>
    </link>

    <joint name="${prefix}_arm_roll_joint" type="revolute">
      <parent link="${prefix}_shoulder_link" />
      <child link="${prefix}_upper_arm_link" />
      <origin xyz="0 ${reflect * 0.04} 0" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0" />
    </joint>

    <!-- Forearm (Elbow) -->
    <link name="${prefix}_forearm_link">
      <visual>
        <origin xyz="0 0 -0.09" rpy="0 0 0" />
        <geometry><cylinder radius="0.022" length="0.18" /></geometry>
        <material name="metallic_silver" />
      </visual>
      <collision>
        <origin xyz="0 0 -0.09" rpy="0 0 0" />
        <geometry><cylinder radius="0.022" length="0.18" /></geometry>
      </collision>
      <inertial><origin xyz="0 0 -0.09" /><mass value="0.4" /><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0003" /></inertial>
    </link>

    <joint name="${prefix}_elbow_joint" type="revolute">
      <parent link="${prefix}_upper_arm_link" />
      <child link="${prefix}_forearm_link" />
      <origin xyz="0 0 -0.20" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit lower="0.0" upper="2.09" effort="8.0" velocity="2.0" />
    </joint>

    <!-- Wrist & Gripper Hand -->
    <link name="${prefix}_hand_link">
      <visual>
        <origin xyz="0.03 0 -0.02" rpy="0 0 0" />
        <geometry><box size="0.06 0.05 0.03" /></geometry>
        <material name="dark_grey" />
      </visual>
      <collision>
        <origin xyz="0.03 0 -0.02" rpy="0 0 0" />
        <geometry><box size="0.06 0.05 0.03" /></geometry>
      </collision>
      <inertial><mass value="0.2" /><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" /></inertial>
    </link>

    <joint name="${prefix}_wrist_joint" type="revolute">
      <parent link="${prefix}_forearm_link" />
      <child link="${prefix}_hand_link" />
      <origin xyz="0 0 -0.18" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="-1.57" upper="1.57" effort="5.0" velocity="2.0" />
    </joint>

    <!-- Gripper Pincer Finger Left -->
    <link name="${prefix}_finger_left_link">
      <visual>
        <origin xyz="0.03 0.015 0" rpy="0 0 0" />
        <geometry><box size="0.05 0.008 0.02" /></geometry>
        <material name="lidar_orange" />
      </visual>
      <collision>
        <origin xyz="0.03 0.015 0" rpy="0 0 0" />
        <geometry><box size="0.05 0.008 0.02" /></geometry>
      </collision>
      <inertial><mass value="0.05" /><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" /></inertial>
    </link>

    <joint name="${prefix}_finger_left_joint" type="prismatic">
      <parent link="${prefix}_hand_link" />
      <child link="${prefix}_finger_left_link" />
      <origin xyz="0.04 0 -0.02" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit lower="0.0" upper="0.03" effort="5.0" velocity="0.5" />
    </joint>

    <!-- Gripper Pincer Finger Right -->
    <link name="${prefix}_finger_right_link">
      <visual>
        <origin xyz="0.03 -0.015 0" rpy="0 0 0" />
        <geometry><box size="0.05 0.008 0.02" /></geometry>
        <material name="lidar_orange" />
      </visual>
      <collision>
        <origin xyz="0.03 -0.015 0" rpy="0 0 0" />
        <geometry><box size="0.05 0.008 0.02" /></geometry>
      </collision>
      <inertial><mass value="0.05" /><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" /></inertial>
    </link>

    <joint name="${prefix}_finger_right_joint" type="prismatic">
      <parent link="${prefix}_hand_link" />
      <child link="${prefix}_finger_right_link" />
      <origin xyz="0.04 0 -0.02" rpy="0 0 0" />
      <axis xyz="0 -1 0" />
      <limit lower="0.0" upper="0.03" effort="5.0" velocity="0.5" />
    </joint>
  </xacro:macro>

  <xacro:humanoid_arm prefix="left" y_offset="0.16" reflect="1" />
  <xacro:humanoid_arm prefix="right" y_offset="-0.16" reflect="-1" />

  <!-- ======================================================================== -->
  <!-- Humanoid Head & Pan/Tilt Mechanism                                       -->
  <!-- ======================================================================== -->
  <link name="neck_pan_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.05" /></geometry>
      <material name="dark_grey" />
    </visual>
    <inertial><mass value="0.2" /><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" /></inertial>
  </link>

  <joint name="neck_pan_joint" type="revolute">
    <parent link="torso_link" />
    <child link="neck_pan_link" />
    <origin xyz="0.0 0 ${torso_height + 0.025}" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="5.0" velocity="2.0" />
  </joint>

  <link name="head_link">
    <visual>
      <origin xyz="0.02 0 0.06" rpy="0 0 0" />
      <geometry><box size="0.14 0.16 0.13" /></geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <origin xyz="0.02 0 0.06" rpy="0 0 0" />
      <geometry><box size="0.14 0.16 0.13" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0.02 0 0.06" rpy="0 0 0" />
      <mass value="0.7" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>

  <joint name="head_tilt_joint" type="revolute">
    <parent link="neck_pan_link" />
    <child link="head_link" />
    <origin xyz="0 0 0.04" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.52" upper="0.78" effort="5.0" velocity="2.0" />
  </joint>

  <!-- ======================================================================== -->
  <!-- Camera Link & Optical Frame                                              -->
  <!-- ======================================================================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0.02" /></geometry>
      <material name="camera_lens_black" />
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="head_link" />
    <child link="camera_link" />
    <origin xyz="0.09 0 0.06" rpy="0 0 0" />
  </joint>

  <link name="camera_optical_link" />

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ======================================================================== -->
  <!-- IMU Link                                                                 -->
  <!-- ======================================================================== -->
  <link name="imu_link" />

  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.10" rpy="0 0 0" />
  </joint>

</robot>
